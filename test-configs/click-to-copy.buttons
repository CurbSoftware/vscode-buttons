version = 1
title = "Click-to-Copy Command"
description = "Tests command_click_to_copy at document and group levels"
layout = "grid"

[display]
show_command = true
show_labels = true
show_icons = true

[macros]
echo = "echo"

# ── Not clickable (default) ──
[groups.no-click]
name = "Not Clickable (Default)"
description = "Command preview is passive text — no click behavior"
icon = "eye"
color = "#64748B"

[[groups.no-click.buttons]]
id = "nc-1"
label = "Normal Command"
command = "npm run build --production --verbose"
icon = "package"

[[groups.no-click.buttons]]
id = "nc-2"
label = "Also Normal"
command = "docker compose up -d --build --force-recreate"
icon = "server"

# ── Click-to-copy enabled ──
[groups.clickable]
name = "Click-to-Copy Enabled"
description = "Clicking the command preview copies it to clipboard"
icon = "copy"
color = "#2563EB"

[groups.clickable.display]
command_click_to_copy = true

[[groups.clickable.buttons]]
id = "cc-1"
label = "Clickable Command"
command = "npm run build --production --verbose"
icon = "package"
description = "Click the command preview below to copy it"

[[groups.clickable.buttons]]
id = "cc-2"
label = "Long Command"
command = "docker compose -f docker-compose.yml -f docker-compose.override.yml up -d --build"
icon = "server"
description = "Even long commands can be click-copied"

[[groups.clickable.buttons]]
id = "cc-3"
label = "Multi-word Command"
command = "kubectl apply -f deployment.yaml --namespace production --dry-run=client"
icon = "cloud-upload"

# ── Click-to-copy + compact ──
[groups.compact-click]
name = "Compact + Click-to-Copy"
description = "Click-to-copy works in compact mode too"
icon = "fold"
color = "#16A34A"

[groups.compact-click.display]
command_click_to_copy = true
compact = true

[[groups.compact-click.buttons]]
id = "compcc-1"
label = "Compact Clickable"
command = "npm run dev"
icon = "play"

[[groups.compact-click.buttons]]
id = "compcc-2"
label = "Also Compact"
command = "npm test --watch"
icon = "beaker"

# ── Click-to-copy + no action buttons (command is the only interaction) ──
[groups.click-only]
name = "Click-Only (No Action Buttons)"
description = "All action buttons hidden — clicking command is the only way to interact"
icon = "hand"
color = "#9333EA"

[groups.click-only.display]
command_click_to_copy = true
show_run = false
show_new_terminal = false
show_copy_to_terminal = false
show_copy_to_new_terminal = false
show_copy_to_clipboard = false

[[groups.click-only.buttons]]
id = "co-1"
label = "Click Command to Copy"
command = "git log --oneline --graph --decorate -20"
icon = "history"
description = "The command preview is the only interactive element"

[[groups.click-only.buttons]]
id = "co-2"
label = "Another Click-Only"
command = "find . -name '*.ts' -not -path './node_modules/*' | wc -l"
icon = "search"

# ── Document-level click-to-copy ──
[groups.doc-level]
name = "Document Inherited"
description = "This group inherits click-to-copy from above groups (note: needs document-level setting for all)"
icon = "arrow-down"
color = "#D97706"

[groups.doc-level.display]
command_click_to_copy = true

[[groups.doc-level.buttons]]
id = "dl-1"
label = "Inherited Click"
command = "cargo build --release"
icon = "tools"

[[groups.doc-level.buttons]]
id = "dl-2"
label = "Also Inherited"
command = "cargo test -- --nocapture"
icon = "beaker"
