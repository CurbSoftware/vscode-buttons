version = 1
title = "Per-Group Display Overrides"
description = "Each group overrides different display settings from the document defaults"
layout = "grid"

[display]
show_command = true
show_labels = true
show_icons = true
compact = false
run_label = "Run"
command_click_to_copy = false

[macros]
echo = "echo"

# ── Group 1: Inherits all document defaults ──
[groups.default]
name = "Document Defaults"
description = "No group-level display — inherits everything"
icon = "list-flat"
color = "#64748B"

[[groups.default.buttons]]
id = "d1"
label = "Default Display"
command = "{{echo}} 'document defaults'"
icon = "play"

# ── Group 2: Compact + custom labels ──
[groups.compact-labels]
name = "Compact + Custom Labels"
description = "compact=true, renamed action buttons"
icon = "tag"
color = "#2563EB"

[groups.compact-labels.display]
compact = true
run_label = "Execute"
new_terminal_label = "Fresh"
copy_to_clipboard_label = "Clip"

[[groups.compact-labels.buttons]]
id = "cl1"
label = "Custom Labels"
command = "{{echo}} 'compact with custom labels'"
icon = "play"

# ── Group 3: Icon actions + click-to-copy ──
[groups.icon-click]
name = "Icon Actions + Click-to-Copy"
description = "Action buttons as icons, clickable command preview"
icon = "symbol-color"
color = "#16A34A"

[groups.icon-click.display]
run_icon = "play"
new_terminal_icon = "terminal"
copy_to_terminal_icon = "arrow-right"
copy_to_new_terminal_icon = "split-horizontal"
copy_to_clipboard_icon = "copy"
command_click_to_copy = true

[[groups.icon-click.buttons]]
id = "ic1"
label = "Icon Actions"
command = "npm run build --production"
icon = "package"
description = "Click the command below to copy it"

# ── Group 4: Large styled actions ──
[groups.styled]
name = "Large Styled Actions"
description = "Big pill-shaped action buttons with custom colors"
icon = "paintcan"
color = "#9333EA"

[groups.styled.display]
action_size = "14px"
action_border_radius = "999px"
label_size = "16px"
run_color = "#16A34A"
new_terminal_color = "#2563EB"
copy_to_clipboard_color = "#EF4444"

[[groups.styled.buttons]]
id = "s1"
label = "Large Styled"
command = "{{echo}} 'large styled actions'"
icon = "rocket"

# ── Group 5: Minimal — hide most actions ──
[groups.minimal]
name = "Minimal Actions"
description = "Only Run + Copy, no command preview, icons only"
icon = "dash"
color = "#DC2626"

[groups.minimal.display]
show_command = false
show_labels = false
show_new_terminal = false
show_copy_to_terminal = false
show_copy_to_new_terminal = false
run_icon = "play"
copy_to_clipboard_icon = "copy"

[[groups.minimal.buttons]]
id = "m1"
label = "Minimal"
command = "{{echo}} 'minimal'"
icon = "zap"

[[groups.minimal.buttons]]
id = "m2"
label = "Also Minimal"
command = "{{echo}} 'also minimal'"
icon = "rocket"

# ── Group 6: Table layout with custom display ──
[groups.table-custom]
name = "Table + Custom"
description = "Table layout with custom action labels and colors"
layout = "table"
icon = "table"
color = "#D97706"

[groups.table-custom.display]
run_label = "▶"
new_terminal_label = "+"
copy_to_clipboard_label = "📋"
run_color = "#16A34A"
group_bg_color = "#1A1500"

[[groups.table-custom.buttons]]
id = "tc1"
label = "Start"
command = "{{echo}} 'starting'"
icon = "play"

[[groups.table-custom.buttons]]
id = "tc2"
label = "Stop"
command = "{{echo}} 'stopping'"
icon = "stop"

[[groups.table-custom.buttons]]
id = "tc3"
label = "Status"
command = "{{echo}} 'status'"
icon = "info"
