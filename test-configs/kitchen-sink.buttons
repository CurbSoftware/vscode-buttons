version = 1
title = "Kitchen Sink"
description = "Every feature at once — layouts, colors, actions, generate, macros, variables, danger, links, ports, includes, descriptions"
layout = "grid"
terminal = "current"

[display]
show_command = true
show_labels = true
show_icons = true
compact = false
button_color = "#6366F1"
group_bg_color = "#1A1B2E"
show_run = true
show_new_terminal = true
show_copy_to_terminal = true
show_copy_to_new_terminal = true
show_copy_to_clipboard = true
run_color = "#16A34A"
new_terminal_color = "#2563EB"
copy_to_terminal_color = "#D97706"
copy_to_new_terminal_color = "#9333EA"
copy_to_clipboard_color = "#64748B"

[defaults]
enabled = true
copy_to_clipboard = true
run_in_current_terminal = true
reveal_terminal = true
confirm = false
danger = false

[variables]
project = "kitchen-sink"
port = "3000"
api_port = "4000"
env = "development"

[macros]
echo = "echo"
npm = "npm"
npm_run = "{{npm}} run"
docker = "docker compose"

# ══════════════════════════════════════════════
# GROUP 1: Grid layout with all features
# ══════════════════════════════════════════════
[groups.dev]
name = "Development"
description = "Dev server, build, and watch commands"
layout = "grid"
icon = "rocket"
color = "#0070F3"
ports = [3000, 4000]

[[groups.dev.buttons]]
id = "dev-server"
label = "Dev Server"
command = "{{npm_run}} dev"
description = "Starts the development server on port {{port}}"
icon = "play"
run_in_new_terminal = true
open_ports = [3000]

[[groups.dev.buttons]]
id = "build"
label = "Build"
command = "{{npm_run}} build"
icon = "package"

[[groups.dev.buttons]]
id = "watch"
label = "Watch"
command = "{{npm_run}} watch"
icon = "eye"
run_in_new_terminal = true

[[groups.dev.buttons]]
id = "api"
label = "API Server"
command = "{{npm_run}} api:dev"
description = "Starts the API on port {{api_port}}"
icon = "server"
run_in_new_terminal = true
open_ports = [4000]
open_urls = ["http://localhost:4000/docs"]

[[groups.dev.links]]
label = "App"
url = "http://localhost:3000"
icon = "globe"

[[groups.dev.links]]
label = "API Docs"
url = "http://localhost:4000/docs"
icon = "book"

# ══════════════════════════════════════════════
# GROUP 2: Table layout, compact, custom group colors
# ══════════════════════════════════════════════
[groups.services]
name = "Services"
description = "System services in compact table layout"
layout = "table"
icon = "server"
color = "#48B57A"

[groups.services.display]
compact = true
group_bg_color = "#0F2318"
run_color = "#22C55E"
show_copy_to_terminal = false
show_copy_to_new_terminal = false

[[groups.services.buttons]]
id = "svc-start"
label = "Start All"
command = "{{docker}} up -d"
icon = "play"

[[groups.services.buttons]]
id = "svc-stop"
label = "Stop All"
command = "{{docker}} down"
icon = "stop"

[[groups.services.buttons]]
id = "svc-logs"
label = "Logs"
command = "{{docker}} logs -f --tail=50"
icon = "output"
run_in_new_terminal = true

[[groups.services.buttons]]
id = "svc-ps"
label = "Status"
command = "{{docker}} ps"
icon = "info"

[[groups.services.buttons]]
id = "svc-restart"
label = "Restart"
command = "{{docker}} restart"
icon = "refresh"

[[groups.services.buttons]]
id = "svc-prune"
label = "System Prune"
command = "docker system prune -f"
icon = "trash"
danger = true
confirm = true

# ══════════════════════════════════════════════
# GROUP 3: Flow layout, icons only, no command preview
# ══════════════════════════════════════════════
[groups.git]
name = "Git Quick Actions"
description = "Flow layout with icon-only compact buttons"
layout = "flow"
icon = "git-branch"
color = "#F05033"

[groups.git.display]
show_labels = false
show_command = false
compact = true
show_copy_to_terminal = false
show_copy_to_new_terminal = false
show_new_terminal = false

[[groups.git.buttons]]
id = "gs"
label = "Status"
command = "git status -sb"
icon = "diff"

[[groups.git.buttons]]
id = "ga"
label = "Add All"
command = "git add -A"
icon = "add"

[[groups.git.buttons]]
id = "gc"
label = "Commit"
command = "git commit"
icon = "check"

[[groups.git.buttons]]
id = "gp"
label = "Push"
command = "git push"
icon = "cloud-upload"

[[groups.git.buttons]]
id = "gl"
label = "Pull"
command = "git pull --rebase"
icon = "cloud-download"

[[groups.git.buttons]]
id = "gst"
label = "Stash"
command = "git stash"
icon = "archive"

[[groups.git.buttons]]
id = "gsp"
label = "Stash Pop"
command = "git stash pop"
icon = "discard"

[[groups.git.buttons]]
id = "glog"
label = "Log"
command = "git log --oneline --graph -15"
icon = "history"

[[groups.git.buttons]]
id = "gdiff"
label = "Diff"
command = "git diff"
icon = "compare-changes"

[[groups.git.buttons]]
id = "gbr"
label = "Branches"
command = "git branch -a"
icon = "git-branch"

# ══════════════════════════════════════════════
# GROUP 4: Rows layout with generated buttons
# ══════════════════════════════════════════════
[groups.quality]
name = "Code Quality"
description = "Generated lint/test/format buttons in rows layout"
layout = "rows"
icon = "checklist"
color = "#9D4EDD"

[groups.quality.display]
new_terminal_color = "#7C3AED"
run_color = "#A855F7"

[groups.quality.generate]
mode = "cartesian"
template = "{{npm_run}} {{arg1}}"
label_template = "{{arg1}}"
description_template = "Run {{arg1}} via npm"
params = [["lint", "test", "typecheck", "format", "test:coverage"]]

# ══════════════════════════════════════════════
# GROUP 5: Columns layout with danger buttons
# ══════════════════════════════════════════════
[groups.danger-zone]
name = "Danger Zone"
description = "Destructive operations in columns layout — all marked dangerous"
layout = "columns"
icon = "warning"
color = "#EF4444"

[groups.danger-zone.display]
group_bg_color = "#2D1215"
run_color = "#EF4444"
button_color = "#EF4444"

[[groups.danger-zone.buttons]]
id = "reset-hard"
label = "Git Reset Hard"
command = "git reset --hard HEAD"
icon = "discard"
danger = true
confirm = true
description = "Discards all uncommitted changes"

[[groups.danger-zone.buttons]]
id = "clean"
label = "Git Clean"
command = "git clean -fd"
icon = "trash"
danger = true
confirm = true
description = "Removes untracked files and directories"

[[groups.danger-zone.buttons]]
id = "drop-db"
label = "Drop Database"
command = "{{echo}} 'dropdb {{project}}_{{env}}'"
icon = "flame"
danger = true
confirm = true
description = "Drops the entire database"

[[groups.danger-zone.buttons]]
id = "nuke-modules"
label = "Delete node_modules"
command = "rm -rf node_modules"
icon = "trash"
danger = true
confirm = true

[[groups.danger-zone.buttons]]
id = "force-push"
label = "Force Push"
command = "git push --force-with-lease"
icon = "cloud-upload"
danger = true
confirm = true
description = "Force-pushes to remote (safe variant)"

[[groups.danger-zone.buttons]]
id = "deploy-prod"
label = "Deploy Production"
command = "{{echo}} 'deploying to production...'"
icon = "rocket"
danger = true
confirm = true
description = "Deploys to production — requires confirmation"

# ══════════════════════════════════════════════
# GROUP 6: Multi-dimension cartesian generation
# ══════════════════════════════════════════════
[groups.matrix]
name = "Deploy Matrix"
description = "2D cartesian: 3 services × 2 environments = 6 buttons"
layout = "grid"
icon = "wand"
color = "#D97706"

[groups.matrix.generate]
mode = "cartesian"
template = "{{echo}} 'deploying {{arg1}} to {{arg2}}'"
label_template = "{{arg1}} → {{arg2}}"
description_template = "Deploy {{arg1}} to {{arg2}} environment"
params = [["frontend", "api", "worker"], ["staging", "production"]]

[groups.matrix.generate.defaults]
confirm = true

# ══════════════════════════════════════════════
# GROUP 7: Disabled group (should not render)
# ══════════════════════════════════════════════
[groups.disabled]
name = "Hidden Group"
description = "This group has enabled = false — should not appear in UI"
enabled = false
icon = "circle-slash"

[[groups.disabled.buttons]]
id = "hidden"
label = "You Should Not See This"
command = "{{echo}} 'invisible'"

# ══════════════════════════════════════════════
# GROUP 8: Mixed enabled/disabled buttons
# ══════════════════════════════════════════════
[groups.mixed]
name = "Mixed Visibility"
description = "Some buttons enabled, some disabled — disabled ones filtered out"
icon = "filter"
color = "#78716C"

[[groups.mixed.buttons]]
id = "visible-1"
label = "Visible Button 1"
command = "{{echo}} 'visible 1'"
icon = "check"

[[groups.mixed.buttons]]
id = "hidden-1"
label = "Disabled Button"
command = "{{echo}} 'disabled'"
icon = "circle-slash"
enabled = false

[[groups.mixed.buttons]]
id = "visible-2"
label = "Visible Button 2"
command = "{{echo}} 'visible 2'"
icon = "check"

[[groups.mixed.buttons]]
id = "hidden-2"
label = "Also Disabled"
command = "{{echo}} 'also disabled'"
icon = "circle-slash"
enabled = false

[[groups.mixed.buttons]]
id = "visible-3"
label = "Visible Button 3"
command = "{{echo}} 'visible 3'"
icon = "check"
