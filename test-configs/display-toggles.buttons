version = 1
title = "Display Toggle Combinations"
description = "Each group tests a different combination of show_icons, show_labels, show_command, and compact"
layout = "grid"

[display]
show_command = true
show_labels = true
show_icons = true
compact = false

[macros]
echo = "echo"

# ── All on (default) ──
[groups.all-on]
name = "All Display Options ON"
description = "Icons + Labels + Command Preview + Normal spacing"
icon = "eye"
color = "#16A34A"

[[groups.all-on.buttons]]
id = "all-on-1"
label = "Full Display"
command = "npm run build --verbose --production"
icon = "package"
description = "Every display element is visible"

[[groups.all-on.buttons]]
id = "all-on-2"
label = "Also Full"
command = "docker compose up -d --build"
icon = "server"

# ── Icons only (no labels) ──
[groups.icons-only]
name = "Icons Only (no labels)"
description = "show_labels = false, show_icons = true — buttons should be icon-only with tooltip"
icon = "symbol-color"
color = "#2563EB"

[groups.icons-only.display]
show_labels = false
show_icons = true

[[groups.icons-only.buttons]]
id = "icon-1"
label = "Build"
command = "npm run build"
icon = "package"

[[groups.icons-only.buttons]]
id = "icon-2"
label = "Test"
command = "npm test"
icon = "beaker"

[[groups.icons-only.buttons]]
id = "icon-3"
label = "Deploy"
command = "npm run deploy"
icon = "rocket"

[[groups.icons-only.buttons]]
id = "icon-4"
label = "Lint"
command = "npm run lint"
icon = "verified"

# ── Labels only (no icons) ──
[groups.labels-only]
name = "Labels Only (no icons)"
description = "show_labels = true, show_icons = false"
icon = "tag"
color = "#9333EA"

[groups.labels-only.display]
show_labels = true
show_icons = false

[[groups.labels-only.buttons]]
id = "label-1"
label = "Build Project"
command = "npm run build"
icon = "package"

[[groups.labels-only.buttons]]
id = "label-2"
label = "Run Tests"
command = "npm test"
icon = "beaker"

# ── No command preview ──
[groups.no-command]
name = "No Command Preview"
description = "show_command = false — no code block under buttons"
icon = "eye-closed"
color = "#DC2626"

[groups.no-command.display]
show_command = false

[[groups.no-command.buttons]]
id = "nc-1"
label = "Build"
command = "npm run build --production --verbose"
icon = "package"
description = "This description shows but the command should NOT"

[[groups.no-command.buttons]]
id = "nc-2"
label = "Deploy"
command = "kubectl apply -f deployment.yaml --namespace production"
icon = "rocket"

# ── Compact mode ──
[groups.compact-mode]
name = "Compact Mode"
description = "compact = true — tighter padding and gaps"
icon = "fold"
color = "#D97706"

[groups.compact-mode.display]
compact = true

[[groups.compact-mode.buttons]]
id = "compact-1"
label = "Compact Build"
command = "npm run build"
icon = "package"

[[groups.compact-mode.buttons]]
id = "compact-2"
label = "Compact Test"
command = "npm test"
icon = "beaker"

[[groups.compact-mode.buttons]]
id = "compact-3"
label = "Compact Lint"
command = "npm run lint"
icon = "verified"

[[groups.compact-mode.buttons]]
id = "compact-4"
label = "Compact Deploy"
command = "npm run deploy"
icon = "rocket"

# ── Compact + No command + Icons only ──
[groups.minimal]
name = "Minimal (compact + icons only + no command)"
description = "The most minimal display: compact cards with only icons, no labels or command preview"
icon = "dash"
color = "#64748B"

[groups.minimal.display]
compact = true
show_labels = false
show_icons = true
show_command = false

[[groups.minimal.buttons]]
id = "min-1"
label = "Build"
command = "npm run build"
icon = "package"

[[groups.minimal.buttons]]
id = "min-2"
label = "Test"
command = "npm test"
icon = "beaker"

[[groups.minimal.buttons]]
id = "min-3"
label = "Lint"
command = "npm run lint"
icon = "verified"

[[groups.minimal.buttons]]
id = "min-4"
label = "Start"
command = "npm start"
icon = "play"

[[groups.minimal.buttons]]
id = "min-5"
label = "Stop"
command = "npm stop"
icon = "stop"

# ── Neither icons nor labels (fallback to label text) ──
[groups.no-icons-no-labels]
name = "No Icons, No Labels"
description = "show_icons = false, show_labels = false — should fall back to label text"
icon = "circle-slash"
color = "#78716C"

[groups.no-icons-no-labels.display]
show_icons = false
show_labels = false

[[groups.no-icons-no-labels.buttons]]
id = "noinl-1"
label = "Build"
command = "npm run build"
icon = "package"

[[groups.no-icons-no-labels.buttons]]
id = "noinl-2"
label = "Test"
command = "npm test"
icon = "beaker"
