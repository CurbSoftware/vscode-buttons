version = 1
title = "All Layout Modes"
description = "Each group uses a different layout — copy this file to .buttons to test"
layout = "grid"

[display]
show_command = true
show_labels = true
show_icons = true

[macros]
echo = "echo"

# ── GRID: responsive auto-fit columns (default) ──
[groups.grid-demo]
name = "Grid Layout"
description = "Responsive columns, min 280px each"
layout = "grid"
icon = "layout"
color = "#0070F3"

[[groups.grid-demo.buttons]]
id = "grid-1"
label = "Grid Button 1"
command = "{{echo}} 'grid 1'"
icon = "play"

[[groups.grid-demo.buttons]]
id = "grid-2"
label = "Grid Button 2"
command = "{{echo}} 'grid 2'"
icon = "package"

[[groups.grid-demo.buttons]]
id = "grid-3"
label = "Grid Button 3"
command = "{{echo}} 'grid 3'"
icon = "beaker"

[[groups.grid-demo.buttons]]
id = "grid-4"
label = "Grid Button 4"
command = "{{echo}} 'grid 4'"
icon = "tools"

[[groups.grid-demo.buttons]]
id = "grid-5"
label = "Grid Button 5"
command = "{{echo}} 'grid 5'"
icon = "rocket"

# ── ROWS: single column, full width ──
[groups.rows-demo]
name = "Rows Layout"
description = "Single column, each button takes full width"
layout = "rows"
icon = "list-flat"
color = "#48B57A"

[[groups.rows-demo.buttons]]
id = "rows-1"
label = "Rows Button 1"
command = "{{echo}} 'rows 1'"
icon = "play"

[[groups.rows-demo.buttons]]
id = "rows-2"
label = "Rows Button 2"
command = "{{echo}} 'rows 2'"
icon = "package"

[[groups.rows-demo.buttons]]
id = "rows-3"
label = "Rows Button 3"
command = "{{echo}} 'rows 3'"
icon = "beaker"

# ── COLUMNS: fixed 3-column grid ──
[groups.columns-demo]
name = "Columns Layout"
description = "Fixed 3-column grid regardless of width"
layout = "columns"
icon = "split-horizontal"
color = "#9D4EDD"

[[groups.columns-demo.buttons]]
id = "col-1"
label = "Col 1"
command = "{{echo}} 'col 1'"
icon = "play"

[[groups.columns-demo.buttons]]
id = "col-2"
label = "Col 2"
command = "{{echo}} 'col 2'"
icon = "package"

[[groups.columns-demo.buttons]]
id = "col-3"
label = "Col 3"
command = "{{echo}} 'col 3'"
icon = "beaker"

[[groups.columns-demo.buttons]]
id = "col-4"
label = "Col 4"
command = "{{echo}} 'col 4'"
icon = "tools"

[[groups.columns-demo.buttons]]
id = "col-5"
label = "Col 5"
command = "{{echo}} 'col 5'"
icon = "rocket"

[[groups.columns-demo.buttons]]
id = "col-6"
label = "Col 6"
command = "{{echo}} 'col 6'"
icon = "gear"

# ── TABLE: compact one-row-per-button ──
[groups.table-demo]
name = "Table Layout"
description = "Compact tabular — icon | label | command | actions"
layout = "table"
icon = "table"
color = "#FF6B35"

[[groups.table-demo.buttons]]
id = "tbl-1"
label = "Start Server"
command = "{{echo}} 'starting server'"
icon = "play"

[[groups.table-demo.buttons]]
id = "tbl-2"
label = "Stop Server"
command = "{{echo}} 'stopping server'"
icon = "stop"

[[groups.table-demo.buttons]]
id = "tbl-3"
label = "Restart Server"
command = "{{echo}} 'restarting server'"
icon = "refresh"

[[groups.table-demo.buttons]]
id = "tbl-4"
label = "Check Status"
command = "{{echo}} 'checking status'"
icon = "info"

[[groups.table-demo.buttons]]
id = "tbl-5"
label = "View Logs"
command = "{{echo}} 'viewing logs'"
icon = "output"

[[groups.table-demo.buttons]]
id = "tbl-6"
label = "Clear Logs"
command = "{{echo}} 'clearing logs'"
icon = "trash"

# ── FLOW: horizontal flex-wrap, smaller cards ──
[groups.flow-demo]
name = "Flow Layout"
description = "Small cards that wrap horizontally"
layout = "flow"
icon = "list-ordered"
color = "#DC2626"

[[groups.flow-demo.buttons]]
id = "flow-1"
label = "Status"
command = "{{echo}} 'status'"
icon = "diff"

[[groups.flow-demo.buttons]]
id = "flow-2"
label = "Add"
command = "{{echo}} 'add'"
icon = "add"

[[groups.flow-demo.buttons]]
id = "flow-3"
label = "Commit"
command = "{{echo}} 'commit'"
icon = "check"

[[groups.flow-demo.buttons]]
id = "flow-4"
label = "Push"
command = "{{echo}} 'push'"
icon = "cloud-upload"

[[groups.flow-demo.buttons]]
id = "flow-5"
label = "Pull"
command = "{{echo}} 'pull'"
icon = "cloud-download"

[[groups.flow-demo.buttons]]
id = "flow-6"
label = "Stash"
command = "{{echo}} 'stash'"
icon = "archive"

[[groups.flow-demo.buttons]]
id = "flow-7"
label = "Log"
command = "{{echo}} 'log'"
icon = "history"

[[groups.flow-demo.buttons]]
id = "flow-8"
label = "Branch"
command = "{{echo}} 'branch'"
icon = "git-branch"

[[groups.flow-demo.buttons]]
id = "flow-9"
label = "Merge"
command = "{{echo}} 'merge'"
icon = "git-merge"

[[groups.flow-demo.buttons]]
id = "flow-10"
label = "Diff"
command = "{{echo}} 'diff'"
icon = "compare-changes"
