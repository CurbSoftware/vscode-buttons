version = 1
title = "AWS CLI"
description = "Common AWS service operations"
layout = "grid"
terminal = "current"

[display]
show_command = true
show_labels = true
show_icons = true
button_color = "#FF9900"

[defaults]
reveal_terminal = true
copy_to_clipboard = true

[variables]
profile = "default"
region = "us-east-1"
stack = "my-stack"
bucket = "my-bucket"
function = "my-function"
cluster = "my-cluster"
table = "my-table"

[macros]
aws = "aws --profile {{profile}} --region {{region}}"

[groups.identity]
name = "Identity"
description = "Check authentication and account info"
icon = "account"
color = "#FF9900"

[[groups.identity.buttons]]
id = "whoami"
label = "Who Am I"
command = "{{aws}} sts get-caller-identity"
icon = "account"

[[groups.identity.buttons]]
id = "list-profiles"
label = "List Profiles"
command = "{{aws}} configure list-profiles"
icon = "list-flat"

[groups.s3]
name = "S3"
description = "Bucket and object operations"
icon = "folder"
color = "#569A31"

[[groups.s3.buttons]]
id = "s3-ls"
label = "List Buckets"
command = "{{aws}} s3 ls"
icon = "list-flat"

[[groups.s3.buttons]]
id = "s3-ls-bucket"
label = "List Objects"
command = "{{aws}} s3 ls s3://{{bucket}}/ --human-readable"
icon = "folder-opened"

[[groups.s3.buttons]]
id = "s3-sync"
label = "Sync to S3"
command = "{{aws}} s3 sync ./dist s3://{{bucket}}/"
icon = "cloud-upload"
confirm = true

[[groups.s3.buttons]]
id = "s3-size"
label = "Bucket Size"
command = "{{aws}} s3 ls s3://{{bucket}} --recursive --summarize | tail -2"
icon = "graph"

[groups.lambda]
name = "Lambda"
description = "Function management and invocation"
icon = "zap"
color = "#FF9900"

[[groups.lambda.buttons]]
id = "lambda-list"
label = "List Functions"
command = "{{aws}} lambda list-functions --query 'Functions[].FunctionName' --output table"
icon = "list-flat"

[[groups.lambda.buttons]]
id = "lambda-invoke"
label = "Invoke"
command = "{{aws}} lambda invoke --function-name {{function}} --payload '{}' /dev/stdout"
icon = "play"

[[groups.lambda.buttons]]
id = "lambda-logs"
label = "Recent Logs"
command = "{{aws}} logs tail /aws/lambda/{{function}} --since 1h --follow"
icon = "output"
run_in_new_terminal = true

[[groups.lambda.buttons]]
id = "lambda-config"
label = "Config"
command = "{{aws}} lambda get-function-configuration --function-name {{function}}"
icon = "gear"

[groups.cloudformation]
name = "CloudFormation"
description = "Stack operations"
icon = "layers"
color = "#E7157B"

[[groups.cloudformation.buttons]]
id = "cf-list"
label = "List Stacks"
command = "{{aws}} cloudformation list-stacks --stack-status-filter CREATE_COMPLETE UPDATE_COMPLETE --query 'StackSummaries[].StackName' --output table"
icon = "list-flat"

[[groups.cloudformation.buttons]]
id = "cf-describe"
label = "Describe Stack"
command = "{{aws}} cloudformation describe-stacks --stack-name {{stack}}"
icon = "info"

[[groups.cloudformation.buttons]]
id = "cf-events"
label = "Stack Events"
command = "{{aws}} cloudformation describe-stack-events --stack-name {{stack}} --query 'StackEvents[:10].[Timestamp,LogicalResourceId,ResourceStatus]' --output table"
icon = "history"

[[groups.cloudformation.buttons]]
id = "cf-outputs"
label = "Stack Outputs"
command = "{{aws}} cloudformation describe-stacks --stack-name {{stack}} --query 'Stacks[0].Outputs' --output table"
icon = "output"

[[groups.cloudformation.buttons]]
id = "cf-delete"
label = "Delete Stack"
command = "{{aws}} cloudformation delete-stack --stack-name {{stack}}"
icon = "trash"
danger = true
confirm = true

[groups.ecs]
name = "ECS"
description = "Container orchestration"
icon = "server"
color = "#FF9900"

[[groups.ecs.buttons]]
id = "ecs-clusters"
label = "List Clusters"
command = "{{aws}} ecs list-clusters --output table"
icon = "list-flat"

[[groups.ecs.buttons]]
id = "ecs-services"
label = "List Services"
command = "{{aws}} ecs list-services --cluster {{cluster}} --output table"
icon = "list-flat"

[[groups.ecs.buttons]]
id = "ecs-tasks"
label = "Running Tasks"
command = "{{aws}} ecs list-tasks --cluster {{cluster}} --desired-status RUNNING --output table"
icon = "eye"

[groups.dynamodb]
name = "DynamoDB"
icon = "database"
color = "#4053D6"

[[groups.dynamodb.buttons]]
id = "ddb-tables"
label = "List Tables"
command = "{{aws}} dynamodb list-tables --output table"
icon = "list-flat"

[[groups.dynamodb.buttons]]
id = "ddb-describe"
label = "Describe Table"
command = "{{aws}} dynamodb describe-table --table-name {{table}}"
icon = "info"

[[groups.dynamodb.buttons]]
id = "ddb-scan"
label = "Scan (10 items)"
command = "{{aws}} dynamodb scan --table-name {{table}} --max-items 10"
icon = "search"
