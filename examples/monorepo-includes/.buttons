version = 1
title = "Monorepo (Includes)"
description = "Root config that includes per-package .buttons files"
layout = "grid"
terminal = "current"

# Include per-package button definitions
includes = [
  "packages/api/.buttons",
  "packages/web/.buttons",
  "packages/shared/.buttons",
]

[display]
show_command = true
show_labels = true
show_icons = true

[defaults]
reveal_terminal = true
copy_to_clipboard = true

[macros]
pnpm = "pnpm"
turbo = "pnpm turbo"

[variables]
registry = "ghcr.io/myorg"

# Root-level workspace commands
[groups.workspace]
name = "Workspace"
description = "Root-level commands for the entire monorepo"
icon = "folder-library"
color = "#FF4785"

[[groups.workspace.buttons]]
id = "install"
label = "Install All"
command = "{{pnpm}} install"
icon = "cloud-download"

[[groups.workspace.buttons]]
id = "build-all"
label = "Build All"
command = "{{turbo}} build"
icon = "package"

[[groups.workspace.buttons]]
id = "test-all"
label = "Test All"
command = "{{turbo}} test"
icon = "beaker"

[[groups.workspace.buttons]]
id = "lint-all"
label = "Lint All"
command = "{{turbo}} lint"
icon = "verified"

[[groups.workspace.buttons]]
id = "clean"
label = "Clean"
command = "{{turbo}} clean"
icon = "trash"
confirm = true
