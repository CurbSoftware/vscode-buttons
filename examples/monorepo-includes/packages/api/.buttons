version = 1
title = "API Package"

[macros]
api = "pnpm --filter @mono/api"

[variables]
api_port = "4000"

[groups.api]
name = "API Server"
description = "Express/Fastify backend"
icon = "server"
color = "#48B57A"
ports = [4000]

[[groups.api.buttons]]
id = "api-dev"
label = "Dev"
command = "{{api}} dev"
icon = "play"
run_in_new_terminal = true
open_ports = [4000]

[[groups.api.buttons]]
id = "api-build"
label = "Build"
command = "{{api}} build"
icon = "package"

[[groups.api.buttons]]
id = "api-test"
label = "Test"
command = "{{api}} test"
icon = "beaker"

[[groups.api.buttons]]
id = "api-lint"
label = "Lint"
command = "{{api}} lint"
icon = "verified"

[[groups.api.buttons]]
id = "api-migrate"
label = "Migrate DB"
command = "{{api}} db:migrate"
icon = "database"
confirm = true

[[groups.api.links]]
label = "API"
url = "http://localhost:4000"
icon = "globe"

[[groups.api.links]]
label = "API Docs"
url = "http://localhost:4000/docs"
icon = "book"
