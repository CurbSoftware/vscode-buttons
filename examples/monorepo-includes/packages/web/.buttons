version = 1
title = "Web Package"

[macros]
web = "pnpm --filter @mono/web"

[variables]
web_port = "3000"

[groups.web]
name = "Web App"
description = "Next.js frontend"
icon = "globe"
color = "#0070F3"
ports = [3000]

[[groups.web.buttons]]
id = "web-dev"
label = "Dev"
command = "{{web}} dev"
icon = "play"
run_in_new_terminal = true
open_ports = [3000]

[[groups.web.buttons]]
id = "web-build"
label = "Build"
command = "{{web}} build"
icon = "package"

[[groups.web.buttons]]
id = "web-test"
label = "Test"
command = "{{web}} test"
icon = "beaker"

[[groups.web.buttons]]
id = "web-lint"
label = "Lint"
command = "{{web}} lint"
icon = "verified"

[[groups.web.buttons]]
id = "web-storybook"
label = "Storybook"
command = "{{web}} storybook"
icon = "symbol-color"
run_in_new_terminal = true
open_ports = [6006]

[[groups.web.links]]
label = "App"
url = "http://localhost:3000"
icon = "globe"
