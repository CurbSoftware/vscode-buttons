version = 1
title = "Flutter"
description = "Flutter mobile and web development"
layout = "grid"
terminal = "current"

[display]
show_command = true
show_labels = true
show_icons = true
button_color = "#027DFD"

[macros]
flutter = "flutter"
dart = "dart"

[groups.run]
name = "Run & Build"
icon = "play"
color = "#027DFD"

[[groups.run.buttons]]
id = "run"
label = "Run (Debug)"
command = "{{flutter}} run"
icon = "debug-start"
run_in_new_terminal = true

[[groups.run.buttons]]
id = "run-chrome"
label = "Run (Chrome)"
command = "{{flutter}} run -d chrome"
icon = "browser"
run_in_new_terminal = true

[[groups.run.buttons]]
id = "run-release"
label = "Run (Release)"
command = "{{flutter}} run --release"
icon = "play"
run_in_new_terminal = true

[[groups.run.buttons]]
id = "build-apk"
label = "Build APK"
command = "{{flutter}} build apk"
icon = "package"

[[groups.run.buttons]]
id = "build-ios"
label = "Build iOS"
command = "{{flutter}} build ios"
icon = "package"

[[groups.run.buttons]]
id = "build-web"
label = "Build Web"
command = "{{flutter}} build web"
icon = "globe"

[[groups.run.buttons]]
id = "build-appbundle"
label = "Build App Bundle"
command = "{{flutter}} build appbundle"
icon = "package"

[groups.test]
name = "Testing"
icon = "beaker"
color = "#48B57A"

[[groups.test.buttons]]
id = "test"
label = "Test"
command = "{{flutter}} test"
icon = "beaker"

[[groups.test.buttons]]
id = "test-coverage"
label = "Coverage"
command = "{{flutter}} test --coverage"
icon = "graph"

[[groups.test.buttons]]
id = "integration"
label = "Integration"
command = "{{flutter}} test integration_test"
icon = "browser"

[[groups.test.buttons]]
id = "analyze"
label = "Analyze"
command = "{{flutter}} analyze"
icon = "verified"

[groups.quality]
name = "Code Quality"
icon = "checklist"

[[groups.quality.buttons]]
id = "format"
label = "Format"
command = "{{dart}} format ."
icon = "symbol-color"

[[groups.quality.buttons]]
id = "fix"
label = "Fix"
command = "{{dart}} fix --apply"
icon = "wand"

[[groups.quality.buttons]]
id = "fix-dry"
label = "Fix (Dry Run)"
command = "{{dart}} fix --dry-run"
icon = "eye"

[groups.deps]
name = "Packages"
icon = "extensions"

[[groups.deps.buttons]]
id = "pub-get"
label = "Pub Get"
command = "{{flutter}} pub get"
icon = "cloud-download"

[[groups.deps.buttons]]
id = "pub-upgrade"
label = "Pub Upgrade"
command = "{{flutter}} pub upgrade"
icon = "sync"

[[groups.deps.buttons]]
id = "pub-outdated"
label = "Outdated"
command = "{{flutter}} pub outdated"
icon = "arrow-up"

[[groups.deps.buttons]]
id = "pub-deps"
label = "Dep Tree"
command = "{{flutter}} pub deps"
icon = "list-tree"

[groups.codegen]
name = "Code Generation"
icon = "wand"
color = "#FF9800"

[[groups.codegen.buttons]]
id = "build-runner"
label = "Build Runner"
command = "{{dart}} run build_runner build --delete-conflicting-outputs"
icon = "wand"

[[groups.codegen.buttons]]
id = "build-watch"
label = "Build Runner (Watch)"
command = "{{dart}} run build_runner watch --delete-conflicting-outputs"
icon = "eye"
run_in_new_terminal = true

[[groups.codegen.buttons]]
id = "gen-l10n"
label = "Generate L10n"
command = "{{flutter}} gen-l10n"
icon = "globe"

[groups.device]
name = "Devices"
icon = "device-mobile"
color = "#6B8AFF"

[[groups.device.buttons]]
id = "devices"
label = "List Devices"
command = "{{flutter}} devices"
icon = "list-flat"

[[groups.device.buttons]]
id = "emulators"
label = "List Emulators"
command = "{{flutter}} emulators"
icon = "device-mobile"

[[groups.device.buttons]]
id = "doctor"
label = "Flutter Doctor"
command = "{{flutter}} doctor -v"
icon = "heart"

[[groups.device.buttons]]
id = "clean"
label = "Clean"
command = "{{flutter}} clean"
icon = "trash"
