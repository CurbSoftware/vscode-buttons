version = 1
title = "Next.js Fullstack"
description = "Next.js app with Prisma, tRPC, and Tailwind"
layout = "grid"
terminal = "current"

[display]
show_command = true
show_labels = true
show_icons = true
compact = false

[defaults]
reveal_terminal = true
copy_to_clipboard = true

[variables]
port = "3000"

[macros]
npm = "npm run"
npx = "npx"

[groups.dev]
name = "Development"
description = "Start the dev server and related tools"
icon = "play"
color = "#0070F3"
ports = [3000]

[[groups.dev.buttons]]
id = "dev"
label = "Dev Server"
command = "{{npm}} dev"
icon = "debug-start"
run_in_new_terminal = true
open_ports = [3000]

[[groups.dev.buttons]]
id = "dev-turbo"
label = "Dev (Turbo)"
command = "{{npm}} dev --turbo"
icon = "zap"
run_in_new_terminal = true
open_ports = [3000]

[[groups.dev.buttons]]
id = "build"
label = "Build"
command = "{{npm}} build"
icon = "package"

[[groups.dev.buttons]]
id = "start"
label = "Start (Prod)"
command = "{{npm}} start"
icon = "play"
run_in_new_terminal = true
open_ports = [3000]

[[groups.dev.buttons]]
id = "analyze"
label = "Bundle Analyzer"
command = "ANALYZE=true {{npm}} build"
icon = "graph"

[[groups.dev.links]]
label = "App"
url = "http://localhost:3000"
icon = "globe"

[groups.prisma]
name = "Prisma ORM"
description = "Database schema and migrations"
icon = "database"
color = "#2D3748"

[[groups.prisma.buttons]]
id = "prisma-push"
label = "DB Push"
command = "{{npx}} prisma db push"
icon = "arrow-up"

[[groups.prisma.buttons]]
id = "prisma-pull"
label = "DB Pull"
command = "{{npx}} prisma db pull"
icon = "arrow-down"

[[groups.prisma.buttons]]
id = "prisma-generate"
label = "Generate"
command = "{{npx}} prisma generate"
icon = "wand"

[[groups.prisma.buttons]]
id = "prisma-migrate"
label = "Migrate Dev"
command = "{{npx}} prisma migrate dev"
icon = "arrow-swap"

[[groups.prisma.buttons]]
id = "prisma-studio"
label = "Studio"
command = "{{npx}} prisma studio"
icon = "browser"
run_in_new_terminal = true
open_ports = [5555]

[[groups.prisma.buttons]]
id = "prisma-seed"
label = "Seed"
command = "{{npx}} prisma db seed"
icon = "sparkle"

[[groups.prisma.buttons]]
id = "prisma-reset"
label = "Reset DB"
command = "{{npx}} prisma migrate reset"
icon = "trash"
danger = true
confirm = true

[[groups.prisma.links]]
label = "Prisma Studio"
url = "http://localhost:5555"
icon = "link-external"

[groups.quality]
name = "Quality & Lint"
icon = "checklist"
color = "#48B57A"

[[groups.quality.buttons]]
id = "lint"
label = "ESLint"
command = "{{npm}} lint"
icon = "verified"

[[groups.quality.buttons]]
id = "lint-fix"
label = "ESLint Fix"
command = "{{npm}} lint -- --fix"
icon = "wand"

[[groups.quality.buttons]]
id = "typecheck"
label = "TypeCheck"
command = "tsc --noEmit"
icon = "symbol-type-parameter"

[[groups.quality.buttons]]
id = "format"
label = "Prettier"
command = "{{npx}} prettier --write ."
icon = "symbol-color"

[[groups.quality.buttons]]
id = "format-check"
label = "Prettier Check"
command = "{{npx}} prettier --check ."
icon = "eye"

[groups.test]
name = "Testing"
icon = "beaker"
color = "#C21325"

[[groups.test.buttons]]
id = "test"
label = "Test"
command = "{{npm}} test"
icon = "beaker"

[[groups.test.buttons]]
id = "test-watch"
label = "Test (Watch)"
command = "{{npm}} test -- --watch"
icon = "eye"
run_in_new_terminal = true

[[groups.test.buttons]]
id = "test-coverage"
label = "Coverage"
command = "{{npm}} test -- --coverage"
icon = "graph"

[[groups.test.buttons]]
id = "e2e"
label = "E2E (Playwright)"
command = "{{npx}} playwright test"
icon = "browser"

[[groups.test.buttons]]
id = "e2e-ui"
label = "E2E (UI Mode)"
command = "{{npx}} playwright test --ui"
icon = "browser"
run_in_new_terminal = true

[groups.tailwind]
name = "Tailwind CSS"
icon = "symbol-color"
color = "#06B6D4"

[[groups.tailwind.buttons]]
id = "tw-build"
label = "Build CSS"
command = "{{npx}} tailwindcss -o dist/output.css"
icon = "tools"

[[groups.tailwind.buttons]]
id = "tw-watch"
label = "Watch CSS"
command = "{{npx}} tailwindcss -o dist/output.css --watch"
icon = "eye"
run_in_new_terminal = true
