version = 1
title = "Java + Gradle"
description = "Spring Boot application with Gradle build system"
layout = "grid"
terminal = "current"

[display]
show_command = true
show_labels = true
show_icons = true

[macros]
gradle = "./gradlew"

[variables]
main_class = "com.example.Application"
port = "8080"

[groups.build]
name = "Build"
description = "Compile and package"
icon = "tools"
color = "#02303A"

[[groups.build.buttons]]
id = "build"
label = "Build"
command = "{{gradle}} build"
icon = "tools"

[[groups.build.buttons]]
id = "build-skip-tests"
label = "Build (Skip Tests)"
command = "{{gradle}} build -x test"
icon = "tools"

[[groups.build.buttons]]
id = "clean"
label = "Clean"
command = "{{gradle}} clean"
icon = "trash"

[[groups.build.buttons]]
id = "clean-build"
label = "Clean Build"
command = "{{gradle}} clean build"
icon = "refresh"

[[groups.build.buttons]]
id = "jar"
label = "Create JAR"
command = "{{gradle}} bootJar"
icon = "package"

[[groups.build.buttons]]
id = "deps"
label = "Dependencies"
command = "{{gradle}} dependencies"
icon = "list-tree"

[groups.run]
name = "Run & Debug"
icon = "play"
color = "#6DB33F"
ports = [8080]

[[groups.run.buttons]]
id = "bootrun"
label = "Boot Run"
command = "{{gradle}} bootRun"
icon = "debug-start"
run_in_new_terminal = true
open_ports = [8080]

[[groups.run.buttons]]
id = "bootrun-debug"
label = "Boot Run (Debug)"
command = "{{gradle}} bootRun --debug-jvm"
icon = "debug"
run_in_new_terminal = true
open_ports = [8080]

[[groups.run.buttons]]
id = "run-jar"
label = "Run JAR"
command = "java -jar build/libs/*.jar"
icon = "play"
run_in_new_terminal = true
open_ports = [8080]

[[groups.run.links]]
label = "App"
url = "http://localhost:8080"
icon = "globe"

[[groups.run.links]]
label = "Actuator"
url = "http://localhost:8080/actuator/health"
icon = "heart"

[[groups.run.links]]
label = "Swagger"
url = "http://localhost:8080/swagger-ui.html"
icon = "book"

[groups.test]
name = "Testing"
icon = "beaker"
color = "#48B57A"

[[groups.test.buttons]]
id = "test"
label = "Test All"
command = "{{gradle}} test"
icon = "beaker"

[[groups.test.buttons]]
id = "test-verbose"
label = "Test (Verbose)"
command = "{{gradle}} test --info"
icon = "output"

[[groups.test.buttons]]
id = "integration"
label = "Integration Tests"
command = "{{gradle}} integrationTest"
icon = "browser"

[[groups.test.buttons]]
id = "coverage"
label = "JaCoCo Report"
command = "{{gradle}} jacocoTestReport"
icon = "graph"

[groups.quality]
name = "Code Quality"
icon = "shield"

[[groups.quality.buttons]]
id = "checkstyle"
label = "Checkstyle"
command = "{{gradle}} checkstyleMain"
icon = "verified"

[[groups.quality.buttons]]
id = "spotbugs"
label = "SpotBugs"
command = "{{gradle}} spotbugsMain"
icon = "bug"

[[groups.quality.buttons]]
id = "pmd"
label = "PMD"
command = "{{gradle}} pmdMain"
icon = "search"

[groups.docker]
name = "Docker"
icon = "server"
color = "#2496ED"

[[groups.docker.buttons]]
id = "docker-build"
label = "Docker Build"
command = "docker build -t myapp:latest ."
icon = "tools"

[[groups.docker.buttons]]
id = "docker-run"
label = "Docker Run"
command = "docker run -p {{port}}:{{port}} myapp:latest"
icon = "play"
run_in_new_terminal = true
open_ports = [8080]

[[groups.docker.buttons]]
id = "compose-up"
label = "Compose Up"
command = "docker compose up -d"
icon = "play"
