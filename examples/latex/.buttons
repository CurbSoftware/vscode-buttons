version = 1
title = "LaTeX"
description = "LaTeX document compilation and preview"
layout = "flow"
terminal = "current"

[display]
show_command = true
show_labels = true
show_icons = true
compact = true

[variables]
main = "main"

[groups.compile]
name = "Compile"
description = "Build the document"
icon = "file-pdf"
color = "#008080"

[[groups.compile.buttons]]
id = "pdflatex"
label = "pdfLaTeX"
command = "pdflatex {{main}}.tex"
icon = "play"

[[groups.compile.buttons]]
id = "xelatex"
label = "XeLaTeX"
command = "xelatex {{main}}.tex"
icon = "play"

[[groups.compile.buttons]]
id = "lualatex"
label = "LuaLaTeX"
command = "lualatex {{main}}.tex"
icon = "play"

[[groups.compile.buttons]]
id = "bibtex"
label = "BibTeX"
command = "bibtex {{main}}"
icon = "book"

[[groups.compile.buttons]]
id = "biber"
label = "Biber"
command = "biber {{main}}"
icon = "book"

[[groups.compile.buttons]]
id = "makeindex"
label = "MakeIndex"
command = "makeindex {{main}}"
icon = "list-ordered"

[[groups.compile.buttons]]
id = "full-build"
label = "Full Build"
command = "pdflatex {{main}}.tex && bibtex {{main}} && pdflatex {{main}}.tex && pdflatex {{main}}.tex"
icon = "package"
description = "pdflatex -> bibtex -> pdflatex -> pdflatex"

[groups.preview]
name = "Preview"
icon = "eye"
color = "#6B8AFF"

[[groups.preview.buttons]]
id = "open-pdf"
label = "Open PDF"
command = "open {{main}}.pdf 2>/dev/null || xdg-open {{main}}.pdf 2>/dev/null || start {{main}}.pdf"
icon = "file-pdf"

[[groups.preview.buttons]]
id = "latexmk-watch"
label = "Watch (latexmk)"
command = "latexmk -pdf -pvc {{main}}.tex"
icon = "eye"
run_in_new_terminal = true
description = "Continuous compilation with preview"

[groups.clean]
name = "Clean"
icon = "trash"

[[groups.clean.buttons]]
id = "clean-aux"
label = "Clean Aux"
command = "rm -f {{main}}.aux {{main}}.log {{main}}.toc {{main}}.out {{main}}.bbl {{main}}.blg {{main}}.idx {{main}}.ind {{main}}.ilg"
icon = "trash"

[[groups.clean.buttons]]
id = "clean-all"
label = "Clean All"
command = "latexmk -C"
icon = "trash"
confirm = true

[groups.check]
name = "Quality"
icon = "checklist"

[[groups.check.buttons]]
id = "chktex"
label = "ChkTeX"
command = "chktex {{main}}.tex"
icon = "verified"

[[groups.check.buttons]]
id = "word-count"
label = "Word Count"
command = "texcount {{main}}.tex"
icon = "graph"

[[groups.check.buttons]]
id = "page-count"
label = "Page Count"
command = "pdfinfo {{main}}.pdf | grep Pages"
icon = "info"
