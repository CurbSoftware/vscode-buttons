version = 1
title = "Database Operations"
description = "PostgreSQL, Redis, and migration workflows"
layout = "grid"
terminal = "current"

[display]
show_command = true
show_labels = true
show_icons = true
button_color = "#336791"

[defaults]
reveal_terminal = true
copy_to_clipboard = true

[variables]
pg_host = "localhost"
pg_port = "5432"
pg_db = "myapp_dev"
pg_user = "postgres"
redis_host = "localhost"
redis_port = "6379"

[macros]
psql = "psql -h {{pg_host}} -p {{pg_port}} -U {{pg_user}} -d {{pg_db}}"
redis_cli = "redis-cli -h {{redis_host}} -p {{redis_port}}"

[groups.postgres]
name = "PostgreSQL"
description = "Connect, query, and manage Postgres"
icon = "database"
color = "#336791"
ports = [5432]

[[groups.postgres.buttons]]
id = "pg-connect"
label = "Connect (psql)"
command = "{{psql}}"
icon = "terminal"
run_in_new_terminal = true

[[groups.postgres.buttons]]
id = "pg-tables"
label = "List Tables"
command = "{{psql}} -c '\\dt'"
icon = "list-flat"

[[groups.postgres.buttons]]
id = "pg-schemas"
label = "List Schemas"
command = "{{psql}} -c '\\dn'"
icon = "folder"

[[groups.postgres.buttons]]
id = "pg-size"
label = "Database Size"
command = "{{psql}} -c \"SELECT pg_size_pretty(pg_database_size('{{pg_db}}'));\""
icon = "graph"

[[groups.postgres.buttons]]
id = "pg-active"
label = "Active Queries"
command = "{{psql}} -c \"SELECT pid, state, query FROM pg_stat_activity WHERE state='active';\""
icon = "eye"

[[groups.postgres.buttons]]
id = "pg-dump"
label = "Dump"
command = "pg_dump -h {{pg_host}} -p {{pg_port}} -U {{pg_user}} {{pg_db}} > dump_$(date +%Y%m%d_%H%M%S).sql"
icon = "save"

[[groups.postgres.buttons]]
id = "pg-create"
label = "Create Database"
command = "createdb -h {{pg_host}} -p {{pg_port}} -U {{pg_user}} {{pg_db}}"
icon = "add"

[[groups.postgres.buttons]]
id = "pg-drop"
label = "Drop Database"
command = "dropdb -h {{pg_host}} -p {{pg_port}} -U {{pg_user}} {{pg_db}}"
icon = "trash"
danger = true
confirm = true

[groups.migrations]
name = "Migrations"
description = "Database migration management"
icon = "arrow-swap"
color = "#48B57A"

[[groups.migrations.buttons]]
id = "migrate-up"
label = "Migrate Up"
command = "npx prisma migrate dev"
icon = "arrow-up"

[[groups.migrations.buttons]]
id = "migrate-reset"
label = "Reset"
command = "npx prisma migrate reset"
icon = "discard"
danger = true
confirm = true

[[groups.migrations.buttons]]
id = "migrate-status"
label = "Status"
command = "npx prisma migrate status"
icon = "info"

[[groups.migrations.buttons]]
id = "seed"
label = "Seed"
command = "npx prisma db seed"
icon = "sparkle"

[[groups.migrations.buttons]]
id = "generate"
label = "Generate Client"
command = "npx prisma generate"
icon = "wand"

[[groups.migrations.buttons]]
id = "studio"
label = "Prisma Studio"
command = "npx prisma studio"
icon = "browser"
run_in_new_terminal = true
open_ports = [5555]

[groups.redis]
name = "Redis"
description = "Cache management and monitoring"
icon = "flame"
color = "#DC382D"
ports = [6379]

[[groups.redis.buttons]]
id = "redis-connect"
label = "Redis CLI"
command = "{{redis_cli}}"
icon = "terminal"
run_in_new_terminal = true

[[groups.redis.buttons]]
id = "redis-ping"
label = "Ping"
command = "{{redis_cli}} PING"
icon = "radio-tower"

[[groups.redis.buttons]]
id = "redis-info"
label = "Info"
command = "{{redis_cli}} INFO"
icon = "info"

[[groups.redis.buttons]]
id = "redis-keys"
label = "List Keys"
command = "{{redis_cli}} KEYS '*'"
icon = "list-flat"

[[groups.redis.buttons]]
id = "redis-flush"
label = "Flush All"
command = "{{redis_cli}} FLUSHALL"
icon = "trash"
danger = true
confirm = true

[[groups.redis.buttons]]
id = "redis-monitor"
label = "Monitor"
command = "{{redis_cli}} MONITOR"
icon = "eye"
run_in_new_terminal = true
