version = 1
title = "Python Project Commands"
description = "Virtualenv, testing, and app workflows"
layout = "rows"
terminal = "current"

[display]
show_command = true
show_labels = true
show_icons = true
compact = false

[defaults]
enabled = true
copy_to_clipboard = true
run_in_current_terminal = true
run_in_new_terminal = false
confirm = false
danger = false
reveal_terminal = true

[macros]
python = "python"

[groups.environment]
name = "Environment"
description = "Set up local Python tooling"
icon = "python"

[[groups.environment.buttons]]
id = "venv"
label = "Create venv"
command = "{{python}} -m venv .venv"
icon = "package"

[[groups.environment.buttons]]
id = "pip-install"
label = "Install Requirements"
command = "{{python}} -m pip install -r requirements.txt"
icon = "cloud-download"

[groups.quality]
name = "Quality"
description = "Run tests and static checks"
icon = "checklist"

[[groups.quality.buttons]]
id = "pytest"
label = "Pytest"
command = "{{python}} -m pytest"
icon = "beaker"

[[groups.quality.buttons]]
id = "ruff"
label = "Ruff"
command = "{{python}} -m ruff check ."
icon = "verified"

[[groups.quality.buttons]]
id = "format"
label = "Black"
command = "{{python}} -m black ."
icon = "symbol-color"

[groups.app]
name = "Application"
description = "Run common Python app entry points"
icon = "play"
ports = [8000]

[[groups.app.buttons]]
id = "http-server"
label = "http.server"
command = "{{python}} -m http.server 8000"
icon = "debug-start"
run_in_new_terminal = true
open_ports = [8000]

[[groups.app.buttons]]
id = "uvicorn"
label = "Uvicorn"
command = "{{python}} -m uvicorn app:app --reload"
icon = "debug-start"
run_in_new_terminal = true
open_ports = [8000]

[[groups.app.links]]
label = "Local App"
url = "http://localhost:8000"
icon = "link-external"