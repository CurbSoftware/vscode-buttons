version = 1
title = "Settings Showcase"
description = "Demonstrates all display and settings options available"
layout = "grid"
terminal = "current"

[display]
show_command = true
show_labels = true
show_icons = true
compact = false
button_color = "#9D4EDD"
group_bg_color = "#1A1333"

[defaults]
enabled = true
copy_to_clipboard = true
run_in_current_terminal = true
reveal_terminal = true
confirm = false
danger = false

[variables]
project = "showcase"

[macros]
echo = "echo"

# Group with custom color, icon, links, ports — all features shown
[groups.styled]
name = "Styled Group"
description = "Custom colors on group and buttons, with links and ports"
icon = "paintcan"
color = "#FF6B9D"
ports = [3000, 8080]

[[groups.styled.buttons]]
id = "pink"
label = "Pink Button"
command = "{{echo}} 'I am pink'"
icon = "heart"
color = "#FF6B9D"

[[groups.styled.buttons]]
id = "green"
label = "Green Button"
command = "{{echo}} 'I am green'"
icon = "check"
color = "#48B57A"

[[groups.styled.buttons]]
id = "blue"
label = "Blue Button"
command = "{{echo}} 'I am blue'"
icon = "info"
color = "#6B8AFF"

[[groups.styled.buttons]]
id = "orange"
label = "Orange Warning"
command = "{{echo}} 'Careful!'"
icon = "warning"
color = "#FF9800"
confirm = true

[[groups.styled.buttons]]
id = "danger-red"
label = "Danger Button"
command = "{{echo}} 'This is dangerous'"
icon = "flame"
color = "#FF4444"
danger = true
confirm = true

[[groups.styled.links]]
label = "Docs"
url = "https://example.com/docs"
icon = "book"

[[groups.styled.links]]
label = "GitHub"
url = "https://github.com"
icon = "github"

# Group with descriptions on every button
[groups.described]
name = "Described Buttons"
description = "Every button has a description for context"
icon = "info"
color = "#2496ED"

[[groups.described.buttons]]
id = "setup"
label = "Initial Setup"
command = "{{echo}} 'Setting up...'"
icon = "gear"
description = "Run once when first cloning the repository"

[[groups.described.buttons]]
id = "daily"
label = "Daily Start"
command = "{{echo}} 'Starting day...'"
icon = "coffee"
description = "Pull latest changes, install deps, start dev server"

[[groups.described.buttons]]
id = "cleanup"
label = "Cleanup"
command = "{{echo}} 'Cleaning...'"
icon = "trash"
description = "Remove build artifacts, node_modules, and temp files"
confirm = true

# Group demonstrating URL and port opening
[groups.external]
name = "External Resources"
description = "Buttons that open URLs and ports"
icon = "link-external"
color = "#48B57A"

[[groups.external.buttons]]
id = "open-dashboard"
label = "Open Dashboard"
command = "{{echo}} 'Opening dashboard'"
icon = "dashboard"
open_urls = ["https://example.com/dashboard"]

[[groups.external.buttons]]
id = "open-api"
label = "Open API Docs"
command = "{{echo}} 'Opening API'"
icon = "book"
open_urls = ["https://example.com/api"]

[[groups.external.buttons]]
id = "open-local"
label = "Open Local App"
command = "{{echo}} 'Opening local'"
icon = "globe"
open_ports = [3000, 8080]

# Group using generate with many combinations
[groups.generated]
name = "Generated Matrix"
description = "Cartesian product: 3 environments x 3 actions = 9 buttons"
icon = "wand"
color = "#FF9800"

[groups.generated.generate]
mode = "cartesian"
template = "{{echo}} '{{arg1}} -> {{arg2}}'"
label_template = "{{arg1}} {{arg2}}"
description_template = "Run {{arg2}} in {{arg1}} environment"
params = [["dev", "staging", "prod"], ["deploy", "rollback", "status"]]

# Group showing terminal mode variations
[groups.terminals]
name = "Terminal Modes"
description = "Different terminal behaviors"
icon = "terminal"
color = "#9D4EDD"

[[groups.terminals.buttons]]
id = "current"
label = "Current Terminal"
command = "{{echo}} 'Running in current terminal'"
icon = "terminal"
run_in_current_terminal = true

[[groups.terminals.buttons]]
id = "new"
label = "New Terminal"
command = "{{echo}} 'Running in NEW terminal'"
icon = "split-horizontal"
run_in_new_terminal = true

[[groups.terminals.buttons]]
id = "hidden"
label = "Hidden Terminal"
command = "{{echo}} 'Terminal not revealed'"
icon = "eye-closed"
reveal_terminal = false

[[groups.terminals.buttons]]
id = "copy-only"
label = "Copy Only"
command = "echo 'This gets copied to clipboard'"
icon = "copy"
description = "Just copies the command, doesn't run it"

# Disabled group — should not render
[groups.disabled-group]
name = "Disabled Group"
enabled = false
icon = "circle-slash"

[[groups.disabled-group.buttons]]
id = "hidden-btn"
label = "You Should Not See This"
command = "{{echo}} 'invisible'"

# Group with some disabled buttons
[groups.mixed-enabled]
name = "Mixed Enabled"
description = "Some buttons are disabled and filtered out"
icon = "filter"
color = "#6B8AFF"

[[groups.mixed-enabled.buttons]]
id = "active-1"
label = "Active Button 1"
command = "{{echo}} 'active 1'"
icon = "check"

[[groups.mixed-enabled.buttons]]
id = "disabled-1"
label = "Disabled Button"
command = "{{echo}} 'disabled'"
icon = "circle-slash"
enabled = false

[[groups.mixed-enabled.buttons]]
id = "active-2"
label = "Active Button 2"
command = "{{echo}} 'active 2'"
icon = "check"

# Group with macros, variables, and template combos
[groups.templates]
name = "Template Examples"
description = "Macros, variables, and arg substitution"
icon = "symbol-variable"
base = "echo"
delimiter = " "

[[groups.templates.buttons]]
id = "var"
label = "Variable"
command = "echo 'Project: {{project}}'"
icon = "symbol-variable"

[[groups.templates.buttons]]
id = "base-args"
label = "Base + Args"
args = ["hello", "world"]
icon = "symbol-string"
