version = 1
title = "DevOps & CI/CD"
description = "GitHub Actions, Docker builds, and deployment pipelines"
layout = "rows"
terminal = "current"

[display]
show_command = true
show_labels = true
show_icons = true
button_color = "#2088FF"

[defaults]
reveal_terminal = true
copy_to_clipboard = true

[variables]
registry = "ghcr.io/myorg"
image = "myapp"
tag = "latest"
compose_file = "docker-compose.yml"

[macros]
docker = "docker"
compose = "docker compose -f {{compose_file}}"
gh = "gh"

[groups.github]
name = "GitHub CLI"
description = "Issues, PRs, and Actions from the terminal"
icon = "github"
color = "#333333"

[[groups.github.buttons]]
id = "pr-list"
label = "List PRs"
command = "{{gh}} pr list"
icon = "git-pull-request"

[[groups.github.buttons]]
id = "pr-create"
label = "Create PR"
command = "{{gh}} pr create --web"
icon = "git-pull-request-create"

[[groups.github.buttons]]
id = "pr-view"
label = "View PR"
command = "{{gh}} pr view --web"
icon = "link-external"

[[groups.github.buttons]]
id = "pr-checks"
label = "PR Checks"
command = "{{gh}} pr checks"
icon = "verified"

[[groups.github.buttons]]
id = "run-list"
label = "Recent Runs"
command = "{{gh}} run list --limit 10"
icon = "history"

[[groups.github.buttons]]
id = "run-watch"
label = "Watch Latest Run"
command = "{{gh}} run watch"
icon = "eye"
run_in_new_terminal = true

[[groups.github.buttons]]
id = "issue-list"
label = "List Issues"
command = "{{gh}} issue list"
icon = "issues"

[[groups.github.buttons]]
id = "release-list"
label = "List Releases"
command = "{{gh}} release list"
icon = "tag"

[groups.docker-build]
name = "Docker Build"
description = "Build, tag, and push container images"
icon = "server"
color = "#2496ED"

[[groups.docker-build.buttons]]
id = "build"
label = "Build"
command = "{{docker}} build -t {{registry}}/{{image}}:{{tag}} ."
icon = "tools"

[[groups.docker-build.buttons]]
id = "build-no-cache"
label = "Build (No Cache)"
command = "{{docker}} build --no-cache -t {{registry}}/{{image}}:{{tag}} ."
icon = "refresh"

[[groups.docker-build.buttons]]
id = "push"
label = "Push"
command = "{{docker}} push {{registry}}/{{image}}:{{tag}}"
icon = "cloud-upload"
confirm = true

[[groups.docker-build.buttons]]
id = "images"
label = "List Images"
command = "{{docker}} images | grep {{image}}"
icon = "list-flat"

[[groups.docker-build.buttons]]
id = "scan"
label = "Scan Image"
command = "{{docker}} scout cves {{registry}}/{{image}}:{{tag}}"
icon = "shield"

[groups.compose]
name = "Docker Compose"
description = "Local multi-service development"
icon = "layers"
color = "#48B57A"

[[groups.compose.buttons]]
id = "up"
label = "Up (Detached)"
command = "{{compose}} up -d"
icon = "play"

[[groups.compose.buttons]]
id = "up-build"
label = "Up (Build)"
command = "{{compose}} up -d --build"
icon = "debug-start"

[[groups.compose.buttons]]
id = "down"
label = "Down"
command = "{{compose}} down"
icon = "stop"

[[groups.compose.buttons]]
id = "down-volumes"
label = "Down + Volumes"
command = "{{compose}} down -v"
icon = "trash"
danger = true
confirm = true

[[groups.compose.buttons]]
id = "ps"
label = "Running Services"
command = "{{compose}} ps"
icon = "list-flat"

[[groups.compose.buttons]]
id = "logs"
label = "Follow Logs"
command = "{{compose}} logs -f --tail=50"
icon = "output"
run_in_new_terminal = true

[[groups.compose.buttons]]
id = "restart"
label = "Restart All"
command = "{{compose}} restart"
icon = "refresh"

[groups.deploy]
name = "Deploy"
description = "Production deployment commands"
icon = "rocket"
color = "#FF6B35"

[[groups.deploy.buttons]]
id = "deploy-staging"
label = "Deploy Staging"
command = "{{gh}} workflow run deploy.yml -f environment=staging"
icon = "cloud-upload"
confirm = true

[[groups.deploy.buttons]]
id = "deploy-production"
label = "Deploy Production"
command = "{{gh}} workflow run deploy.yml -f environment=production"
icon = "rocket"
danger = true
confirm = true

[[groups.deploy.buttons]]
id = "rollback"
label = "Rollback"
command = "{{gh}} workflow run rollback.yml"
icon = "discard"
danger = true
confirm = true
