version = 1
title = "Development Dashboard"
description = "Fixed 3-column layout for organized command access"
layout = "columns"
terminal = "current"

[display]
show_command = true
show_labels = true
show_icons = true
compact = false
group_bg_color = "#1E2333"

[defaults]
reveal_terminal = true
copy_to_clipboard = true

[macros]
pnpm = "pnpm"

[groups.frontend]
name = "Frontend"
description = "React/Vue development"
icon = "browser"
color = "#61DAFB"
ports = [3000]

[[groups.frontend.buttons]]
id = "fe-dev"
label = "Dev Server"
command = "{{pnpm}} run dev"
icon = "play"
run_in_new_terminal = true
open_ports = [3000]

[[groups.frontend.buttons]]
id = "fe-build"
label = "Build"
command = "{{pnpm}} run build"
icon = "package"

[[groups.frontend.buttons]]
id = "fe-test"
label = "Test"
command = "{{pnpm}} run test"
icon = "beaker"

[[groups.frontend.buttons]]
id = "fe-lint"
label = "Lint"
command = "{{pnpm}} run lint"
icon = "verified"

[[groups.frontend.buttons]]
id = "fe-storybook"
label = "Storybook"
command = "{{pnpm}} run storybook"
icon = "symbol-color"
run_in_new_terminal = true
open_ports = [6006]

[[groups.frontend.buttons]]
id = "fe-e2e"
label = "E2E Tests"
command = "{{pnpm}} run e2e"
icon = "browser"

[[groups.frontend.links]]
label = "App"
url = "http://localhost:3000"
icon = "globe"

[groups.backend]
name = "Backend"
description = "API server and worker processes"
icon = "server"
color = "#48B57A"
ports = [4000]

[[groups.backend.buttons]]
id = "be-dev"
label = "API Server"
command = "{{pnpm}} run api:dev"
icon = "play"
run_in_new_terminal = true
open_ports = [4000]

[[groups.backend.buttons]]
id = "be-build"
label = "Build API"
command = "{{pnpm}} run api:build"
icon = "package"

[[groups.backend.buttons]]
id = "be-test"
label = "Test API"
command = "{{pnpm}} run api:test"
icon = "beaker"

[[groups.backend.buttons]]
id = "be-worker"
label = "Worker"
command = "{{pnpm}} run worker:start"
icon = "gear"
run_in_new_terminal = true

[[groups.backend.buttons]]
id = "be-seed"
label = "Seed DB"
command = "{{pnpm}} run db:seed"
icon = "sparkle"

[[groups.backend.buttons]]
id = "be-migrate"
label = "Migrate"
command = "{{pnpm}} run db:migrate"
icon = "arrow-swap"
confirm = true

[[groups.backend.links]]
label = "API Docs"
url = "http://localhost:4000/docs"
icon = "link-external"

[groups.infra]
name = "Infrastructure"
description = "Docker, provisioning, and deployment"
icon = "cloud"
color = "#FF6B35"

[[groups.infra.buttons]]
id = "docker-up"
label = "Docker Up"
command = "docker compose up -d"
icon = "play"

[[groups.infra.buttons]]
id = "docker-down"
label = "Docker Down"
command = "docker compose down"
icon = "stop"

[[groups.infra.buttons]]
id = "docker-logs"
label = "Docker Logs"
command = "docker compose logs -f"
icon = "output"
run_in_new_terminal = true

[[groups.infra.buttons]]
id = "docker-rebuild"
label = "Rebuild"
command = "docker compose up -d --build"
icon = "refresh"

[[groups.infra.buttons]]
id = "deploy-staging"
label = "Deploy Staging"
command = "npm run deploy:staging"
icon = "cloud-upload"
confirm = true

[[groups.infra.buttons]]
id = "deploy-prod"
label = "Deploy Prod"
command = "npm run deploy:production"
icon = "rocket"
danger = true
confirm = true
