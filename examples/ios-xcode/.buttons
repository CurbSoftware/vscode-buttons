version = 1
title = "iOS / Xcode"
description = "Xcode build, test, and simulator commands"
layout = "rows"

[display]
show_command = true
show_labels = true
show_icons = true

[variables]
scheme = "MyApp"
project = "MyApp.xcodeproj"
workspace = "MyApp.xcworkspace"
simulator = "iPhone 15 Pro"
destination = "platform=iOS Simulator,name=iPhone 15 Pro"

[macros]
xcodebuild = "xcodebuild -workspace {{workspace}} -scheme {{scheme}}"
simctl = "xcrun simctl"

[groups.build]
name = "Build"
icon = "tools"
color = "#147EFB"

[[groups.build.buttons]]
id = "build"
label = "Build"
command = "{{xcodebuild}} -destination '{{destination}}' build"
icon = "tools"

[[groups.build.buttons]]
id = "build-release"
label = "Build (Release)"
command = "{{xcodebuild}} -configuration Release -destination '{{destination}}' build"
icon = "package"

[[groups.build.buttons]]
id = "clean"
label = "Clean"
command = "{{xcodebuild}} clean"
icon = "trash"

[[groups.build.buttons]]
id = "archive"
label = "Archive"
command = "{{xcodebuild}} -configuration Release archive -archivePath build/{{scheme}}.xcarchive"
icon = "package"

[groups.test]
name = "Testing"
icon = "beaker"
color = "#48B57A"

[[groups.test.buttons]]
id = "test"
label = "Run Tests"
command = "{{xcodebuild}} -destination '{{destination}}' test"
icon = "beaker"

[[groups.test.buttons]]
id = "test-ui"
label = "UI Tests"
command = "{{xcodebuild}} -destination '{{destination}}' -testPlan UITests test"
icon = "browser"

[groups.simulator]
name = "Simulator"
icon = "device-mobile"
color = "#FF9800"

[[groups.simulator.buttons]]
id = "list"
label = "List Simulators"
command = "{{simctl}} list devices available"
icon = "list-flat"

[[groups.simulator.buttons]]
id = "boot"
label = "Boot Simulator"
command = "{{simctl}} boot '{{simulator}}'"
icon = "play"

[[groups.simulator.buttons]]
id = "shutdown"
label = "Shutdown Simulator"
command = "{{simctl}} shutdown '{{simulator}}'"
icon = "stop"

[[groups.simulator.buttons]]
id = "erase"
label = "Erase Simulator"
command = "{{simctl}} erase '{{simulator}}'"
icon = "trash"
confirm = true

[[groups.simulator.buttons]]
id = "screenshot"
label = "Screenshot"
command = "{{simctl}} io booted screenshot screenshot_$(date +%s).png"
icon = "file-media"

[[groups.simulator.buttons]]
id = "open-simulator"
label = "Open Simulator App"
command = "open -a Simulator"
icon = "device-mobile"

[groups.cocoapods]
name = "CocoaPods"
icon = "extensions"
color = "#EE3322"

[[groups.cocoapods.buttons]]
id = "pod-install"
label = "Pod Install"
command = "pod install"
icon = "cloud-download"

[[groups.cocoapods.buttons]]
id = "pod-update"
label = "Pod Update"
command = "pod update"
icon = "sync"

[[groups.cocoapods.buttons]]
id = "pod-outdated"
label = "Outdated"
command = "pod outdated"
icon = "arrow-up"

[groups.spm]
name = "Swift Package Manager"
icon = "package"

[[groups.spm.buttons]]
id = "spm-resolve"
label = "Resolve"
command = "swift package resolve"
icon = "cloud-download"

[[groups.spm.buttons]]
id = "spm-update"
label = "Update"
command = "swift package update"
icon = "sync"
