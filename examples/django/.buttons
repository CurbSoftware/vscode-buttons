version = 1
title = "Django Project"
description = "Django management commands and development workflows"
layout = "grid"
terminal = "current"

[display]
show_command = true
show_labels = true
show_icons = true
button_color = "#092E20"

[defaults]
reveal_terminal = true
copy_to_clipboard = true

[macros]
manage = "python manage.py"
pip = "pip"

[variables]
app = "myapp"
port = "8000"

[groups.server]
name = "Development Server"
description = "Run and manage the Django dev server"
icon = "play"
color = "#092E20"
ports = [8000]

[[groups.server.buttons]]
id = "runserver"
label = "Run Server"
command = "{{manage}} runserver 0.0.0.0:{{port}}"
icon = "debug-start"
run_in_new_terminal = true
open_ports = [8000]

[[groups.server.buttons]]
id = "runserver-plus"
label = "Run (django-extensions)"
command = "{{manage}} runserver_plus 0.0.0.0:{{port}}"
icon = "zap"
run_in_new_terminal = true
open_ports = [8000]

[[groups.server.buttons]]
id = "shell"
label = "Shell"
command = "{{manage}} shell_plus --ipython"
icon = "terminal"
run_in_new_terminal = true

[[groups.server.buttons]]
id = "dbshell"
label = "DB Shell"
command = "{{manage}} dbshell"
icon = "database"
run_in_new_terminal = true

[[groups.server.links]]
label = "App"
url = "http://localhost:8000"
icon = "globe"

[[groups.server.links]]
label = "Admin"
url = "http://localhost:8000/admin"
icon = "shield"

[groups.database]
name = "Database & Migrations"
icon = "database"
color = "#336791"

[[groups.database.buttons]]
id = "makemigrations"
label = "Make Migrations"
command = "{{manage}} makemigrations"
icon = "wand"

[[groups.database.buttons]]
id = "migrate"
label = "Migrate"
command = "{{manage}} migrate"
icon = "arrow-swap"

[[groups.database.buttons]]
id = "showmigrations"
label = "Show Migrations"
command = "{{manage}} showmigrations"
icon = "list-flat"

[[groups.database.buttons]]
id = "squashmigrations"
label = "Squash Migrations"
command = "{{manage}} squashmigrations {{app}}"
icon = "fold"
confirm = true

[[groups.database.buttons]]
id = "flush"
label = "Flush DB"
command = "{{manage}} flush"
icon = "trash"
danger = true
confirm = true

[[groups.database.buttons]]
id = "loaddata"
label = "Load Fixtures"
command = "{{manage}} loaddata fixtures/initial_data.json"
icon = "cloud-download"

[[groups.database.buttons]]
id = "dumpdata"
label = "Dump Data"
command = "{{manage}} dumpdata {{app}} --indent 2 > fixtures/dump.json"
icon = "save"

[[groups.database.buttons]]
id = "createsuperuser"
label = "Create Superuser"
command = "{{manage}} createsuperuser"
icon = "account"

[groups.testing]
name = "Testing"
icon = "beaker"
color = "#48B57A"

[[groups.testing.buttons]]
id = "test-all"
label = "Test All"
command = "{{manage}} test"
icon = "beaker"

[[groups.testing.buttons]]
id = "test-app"
label = "Test App"
command = "{{manage}} test {{app}}"
icon = "beaker"

[[groups.testing.buttons]]
id = "test-verbose"
label = "Test (Verbose)"
command = "{{manage}} test --verbosity=2"
icon = "output"

[[groups.testing.buttons]]
id = "coverage"
label = "Coverage"
command = "coverage run --source='.' {{manage}} test && coverage html"
icon = "graph"

[groups.quality]
name = "Code Quality"
icon = "checklist"

[[groups.quality.buttons]]
id = "check"
label = "Django Check"
command = "{{manage}} check"
icon = "verified"

[[groups.quality.buttons]]
id = "check-deploy"
label = "Check Deploy"
command = "{{manage}} check --deploy"
icon = "rocket"

[[groups.quality.buttons]]
id = "ruff"
label = "Ruff Lint"
command = "ruff check ."
icon = "shield"

[[groups.quality.buttons]]
id = "ruff-fix"
label = "Ruff Fix"
command = "ruff check --fix ."
icon = "wand"

[[groups.quality.buttons]]
id = "black"
label = "Black Format"
command = "black ."
icon = "symbol-color"

[[groups.quality.buttons]]
id = "mypy"
label = "MyPy"
command = "mypy ."
icon = "symbol-type-parameter"

[groups.static]
name = "Static Files"
icon = "folder"
color = "#FF9800"

[[groups.static.buttons]]
id = "collectstatic"
label = "Collect Static"
command = "{{manage}} collectstatic --noinput"
icon = "cloud-upload"

[[groups.static.buttons]]
id = "findstatic"
label = "Find Static"
command = "{{manage}} findstatic"
icon = "search"

[groups.deps]
name = "Dependencies"
icon = "extensions"

[[groups.deps.buttons]]
id = "install"
label = "Install"
command = "{{pip}} install -r requirements.txt"
icon = "cloud-download"

[[groups.deps.buttons]]
id = "install-dev"
label = "Install Dev"
command = "{{pip}} install -r requirements-dev.txt"
icon = "cloud-download"

[[groups.deps.buttons]]
id = "freeze"
label = "Freeze"
command = "{{pip}} freeze > requirements.txt"
icon = "save"

[[groups.deps.buttons]]
id = "outdated"
label = "Outdated"
command = "{{pip}} list --outdated"
icon = "arrow-up"
