version = 1
title = "Quick Actions"
description = "Flow layout — small button cards that wrap horizontally"
layout = "flow"
terminal = "current"

[display]
show_command = false
show_labels = true
show_icons = true
compact = true
button_color = "#6B8AFF"

[defaults]
reveal_terminal = true
copy_to_clipboard = true

[groups.git]
name = "Git"
icon = "git-branch"
color = "#F05033"

[[groups.git.buttons]]
id = "status"
label = "Status"
command = "git status"
icon = "diff"

[[groups.git.buttons]]
id = "add-all"
label = "Add All"
command = "git add -A"
icon = "add"

[[groups.git.buttons]]
id = "commit"
label = "Commit"
command = "git commit"
icon = "check"

[[groups.git.buttons]]
id = "push"
label = "Push"
command = "git push"
icon = "cloud-upload"

[[groups.git.buttons]]
id = "pull"
label = "Pull"
command = "git pull"
icon = "cloud-download"

[[groups.git.buttons]]
id = "stash"
label = "Stash"
command = "git stash"
icon = "archive"

[[groups.git.buttons]]
id = "stash-pop"
label = "Stash Pop"
command = "git stash pop"
icon = "discard"

[[groups.git.buttons]]
id = "log"
label = "Log"
command = "git log --oneline -15"
icon = "history"

[[groups.git.buttons]]
id = "diff"
label = "Diff"
command = "git diff"
icon = "compare-changes"

[[groups.git.buttons]]
id = "branch"
label = "Branches"
command = "git branch -a"
icon = "git-branch"

[groups.npm]
name = "npm"
icon = "package"
color = "#CB3837"

[groups.npm.generate]
mode = "cartesian"
template = "npm run {{arg1}}"
label_template = "{{arg1}}"
params = [["dev", "build", "test", "lint", "format", "typecheck", "preview", "clean"]]

[groups.files]
name = "Files"
icon = "folder"
color = "#48B57A"

[[groups.files.buttons]]
id = "tree"
label = "Tree"
command = "tree -L 2 -I node_modules"
icon = "list-tree"

[[groups.files.buttons]]
id = "find-large"
label = "Large Files"
command = "find . -type f -size +1M -not -path './node_modules/*' | head -20"
icon = "search"

[[groups.files.buttons]]
id = "disk-usage"
label = "Size"
command = "du -sh * | sort -rh | head -10"
icon = "pie-chart"

[[groups.files.buttons]]
id = "count-lines"
label = "Lines of Code"
command = "find src -name '*.ts' -o -name '*.tsx' | xargs wc -l | tail -1"
icon = "graph"
