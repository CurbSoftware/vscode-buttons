version = 1
title = "Terraform"
description = "Infrastructure as Code workflows"
layout = "rows"
terminal = "current"

[display]
show_command = true
show_labels = true
show_icons = true
button_color = "#7B42BC"
group_bg_color = "#1B1233"

[defaults]
reveal_terminal = true
copy_to_clipboard = true

[variables]
env = "staging"
var_file = "environments/staging.tfvars"

[macros]
tf = "terraform"

[groups.init]
name = "Initialize"
description = "Workspace setup and provider configuration"
icon = "gear"
color = "#7B42BC"

[[groups.init.buttons]]
id = "init"
label = "Init"
command = "{{tf}} init"
icon = "cloud-download"

[[groups.init.buttons]]
id = "init-upgrade"
label = "Init (Upgrade)"
command = "{{tf}} init -upgrade"
icon = "sync"

[[groups.init.buttons]]
id = "workspace-list"
label = "List Workspaces"
command = "{{tf}} workspace list"
icon = "list-flat"

[[groups.init.buttons]]
id = "workspace-select"
label = "Select Workspace"
command = "{{tf}} workspace select {{env}}"
icon = "plug"

[[groups.init.buttons]]
id = "validate"
label = "Validate"
command = "{{tf}} validate"
icon = "verified"

[[groups.init.buttons]]
id = "fmt"
label = "Format"
command = "{{tf}} fmt -recursive"
icon = "symbol-color"

[groups.plan-apply]
name = "Plan & Apply"
description = "Preview and execute infrastructure changes"
icon = "rocket"
color = "#48B57A"

[[groups.plan-apply.buttons]]
id = "plan"
label = "Plan"
command = "{{tf}} plan -var-file={{var_file}}"
icon = "eye"

[[groups.plan-apply.buttons]]
id = "plan-out"
label = "Plan (Save)"
command = "{{tf}} plan -var-file={{var_file}} -out=tfplan"
icon = "save"

[[groups.plan-apply.buttons]]
id = "apply"
label = "Apply"
command = "{{tf}} apply -var-file={{var_file}}"
icon = "check"
confirm = true
danger = true

[[groups.plan-apply.buttons]]
id = "apply-plan"
label = "Apply Saved Plan"
command = "{{tf}} apply tfplan"
icon = "check-all"
confirm = true

[groups.inspect]
name = "State Inspection"
icon = "database"

[[groups.inspect.buttons]]
id = "state-list"
label = "State List"
command = "{{tf}} state list"
icon = "list-tree"

[[groups.inspect.buttons]]
id = "output"
label = "Outputs"
command = "{{tf}} output"
icon = "output"

[[groups.inspect.buttons]]
id = "show"
label = "Show"
command = "{{tf}} show"
icon = "info"

[[groups.inspect.buttons]]
id = "providers"
label = "Providers"
command = "{{tf}} providers"
icon = "extensions"

[groups.destroy]
name = "Destroy"
description = "Tear down infrastructure — use with extreme caution"
icon = "flame"
color = "#FF4444"

[[groups.destroy.buttons]]
id = "destroy-plan"
label = "Destroy Plan"
command = "{{tf}} plan -destroy -var-file={{var_file}}"
icon = "eye"
danger = true

[[groups.destroy.buttons]]
id = "destroy"
label = "Destroy"
command = "{{tf}} destroy -var-file={{var_file}}"
icon = "flame"
danger = true
confirm = true
