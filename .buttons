version = 1
title = "Buttons Extension Workspace"
description = "Real commands for working on the Buttons VS Code extension"
layout = "grid"
terminal = "current"

[display]
show_command = true
show_labels = true
show_icons = true
compact = false

[defaults]
enabled = true
copy_to_clipboard = true
run_in_current_terminal = true
run_in_new_terminal = false
confirm = false
danger = false
reveal_terminal = true

[macros]
npm_run = "npm run"

[groups.workspace]
name = "Workspace"
description = "Install and inspect the project"
icon = "rocket"

[[groups.workspace.buttons]]
id = "install"
label = "Install Dependencies"
command = "npm install"
icon = "package"

[[groups.workspace.buttons]]
id = "typescript-version"
label = "TypeScript Version"
command = "./node_modules/.bin/tsc --version"
icon = "symbol-number"

[groups.quality]
name = "Quality"
description = "Compile and type-check the extension"
icon = "checklist"

[[groups.quality.buttons]]
id = "compile"
label = "Compile"
command = "{{npm_run}} compile"
icon = "play"

[[groups.quality.buttons]]
id = "lint"
label = "Type Check"
command = "{{npm_run}} lint"
icon = "verified"

[groups.development]
name = "Development"
description = "Long-running local workflows"
icon = "tools"

[[groups.development.buttons]]
id = "watch"
label = "Watch TypeScript"
command = "{{npm_run}} watch"
icon = "sync"
run_in_new_terminal = true

[[groups.development.buttons]]
id = "compile-and-lint"
label = "Compile && Lint"
command = "npm run compile && npm run lint"
icon = "run-all"