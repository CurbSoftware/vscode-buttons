version = 1
title = "Buttons Extension"
description = "Develop, test, and release the Buttons VS Code extension"

[macros]
compile = "npm run compile"

[groups.build]
name = "Build"
icon = "check-all"
color = "#16A34A"

[[groups.build.buttons]]
id = "install"
label = "Install"
command = "npm install"
icon = "package"

[[groups.build.buttons]]
id = "compile"
label = "Compile"
command = "{{compile}}"
icon = "play"

[[groups.build.buttons]]
id = "lint"
label = "Type Check"
command = "npm run lint"
icon = "verified"

[[groups.build.buttons]]
id = "watch"
label = "Watch"
command = "npm run watch"
icon = "sync"
run_in_new_terminal = true

[groups.test]
name = "Test"
icon = "beaker"
color = "#9333EA"

[[groups.test.buttons]]
id = "test-all"
label = "All Tests"
command = "npm test"
icon = "run-all"

[[groups.test.buttons]]
id = "test-config"
label = "configHelpers"
command = "{{compile}} && node --test dist/test/configHelpers.test.js"
icon = "beaker"

[[groups.test.buttons]]
id = "test-includes"
label = "includesMerge"
command = "{{compile}} && node --test dist/test/includesMerge.test.js"
icon = "beaker"

[[groups.test.buttons]]
id = "test-generator"
label = "buttonsGenerator"
command = "{{compile}} && node --test dist/test/buttonsGenerator.test.js"
icon = "beaker"

[groups.release]
name = "Release"
icon = "rocket"
color = "#DC2626"

[[groups.release.buttons]]
id = "package"
label = "Package .vsix"
command = "npm run package"
icon = "archive"

[[groups.release.buttons]]
id = "install-vsix"
label = "Install .vsix"
command = "code --install-extension buttons-vscode-*.vsix"
icon = "desktop-download"

[[groups.release.buttons]]
id = "publish-marketplace"
label = "Publish Marketplace"
command = "vsce publish"
icon = "cloud-upload"
danger = true
confirm = true

[[groups.release.buttons]]
id = "publish-openvsx"
label = "Publish Open VSX"
command = "npx ovsx publish buttons-vscode-*.vsix"
icon = "globe"
danger = true
confirm = true

[groups.git]
name = "Git"
icon = "git-branch"
color = "#D97706"
layout = "flow"

[[groups.git.buttons]]
id = "status"
label = "Status"
command = "git status"
icon = "diff"

[[groups.git.buttons]]
id = "log"
label = "Log"
command = "git --no-pager log --oneline --decorate -10"
icon = "history"

[[groups.git.buttons]]
id = "diff"
label = "Diff"
command = "git diff"
icon = "compare-changes"

[[groups.git.buttons]]
id = "fetch"
label = "Fetch"
command = "git fetch --all --prune"
icon = "cloud-download"

[[groups.git.buttons]]
id = "pull"
label = "Pull"
command = "git pull --ff-only"
icon = "arrow-down"
