{
  "name": "buttons-vscode",
  "displayName": "Buttons",
  "description": "Scan your project's scripts - package.json, Makefile, composer.json, justfile, shell, and Python files - into a clickable command launcher. Pick the directories to scan, run, copy, and manage commands in VS Code.",
  "version": "2.2.0",
  "publisher": "CurbSoftware",
  "license": "MIT",
  "pricing": "Free",
  "icon": "media/buttons-icon-128.png",
  "galleryBanner": {
    "color": "#18181b",
    "theme": "dark"
  },
  "markdown": "github",
  "qna": "marketplace",
  "repository": {
    "type": "git",
    "url": "https://github.com/CurbSoftware/vscode-buttons.git"
  },
  "bugs": {
    "url": "https://github.com/CurbSoftware/vscode-buttons/issues"
  },
  "homepage": "https://github.com/CurbSoftware/vscode-buttons#readme",
  "keywords": [
    "buttons",
    "scripts",
    "commands",
    "task-runner",
    "terminal",
    "package.json",
    "shell",
    "bash",
    "python",
    "venv",
    "automation"
  ],
  "engines": {
    "vscode": "^1.97.0"
  },
  "categories": [
    "Other"
  ],
  "activationEvents": [
    "workspaceContains:.buttons.json",
    "onStartupFinished"
  ],
  "main": "./dist/extension.js",
  "contributes": {
    "viewsContainers": {
      "activitybar": [
        {
          "id": "buttons",
          "title": "Buttons",
          "icon": "media/buttons-icon.svg"
        }
      ]
    },
    "views": {
      "buttons": [
        {
          "type": "webview",
          "id": "buttons.sidebarView",
          "name": "Buttons"
        }
      ]
    },
    "commands": [
      {
        "command": "buttons.openPanel",
        "title": "Buttons: Open Panel",
        "icon": {
          "dark": "media/buttons-icon.svg",
          "light": "media/buttons-icon.svg"
        }
      },
      {
        "command": "buttons.rescan",
        "title": "Buttons: Rescan Scripts"
      },
      {
        "command": "buttons.openProjectButtons",
        "title": "Buttons: Open Project Buttons File"
      },
      {
        "command": "buttons.openGlobalButtons",
        "title": "Buttons: Open Global Buttons File"
      },
      {
        "command": "buttons.openMainPanel",
        "title": "Buttons: Open in Editor",
        "icon": {
          "dark": "media/buttons-icon-color.svg",
          "light": "media/buttons-icon-color.svg"
        }
      },
      {
        "command": "buttons.addFileButton",
        "title": "Buttons: Add to Buttons",
        "shortTitle": "Add to Buttons"
      }
    ],
    "menus": {
      "editor/title": [
        {
          "command": "buttons.openMainPanel",
          "group": "navigation",
          "when": "true"
        }
      ],
      "view/title": [
        {
          "command": "buttons.openMainPanel",
          "group": "navigation",
          "when": "view == buttons.sidebarView"
        }
      ],
      "explorer/context": [
        {
          "command": "buttons.addFileButton",
          "group": "buttons",
          "when": "resourceFilename =~ /^(.*\\.sh|app\\.py|main\\.py|manage\\.py|run\\.py|server\\.py|package\\.json|Makefile|justfile|composer\\.json)$/"
        }
      ]
    },
    "configuration": {
      "title": "Buttons",
      "properties": {
        "buttons.textSize": {
          "type": "string",
          "enum": [
            "default",
            "plus2",
            "plus4"
          ],
          "enumDescriptions": [
            "VS Code default text size",
            "VS Code default + 2px",
            "VS Code default + 4px"
          ],
          "default": "default",
          "description": "Text size used in the Buttons UI.",
          "scope": "window"
        },
        "buttons.scriptFiles": {
          "type": "array",
          "items": {
            "type": "string",
            "enum": [
              "package.json",
              "Makefile",
              "composer.json",
              "justfile",
              "shell",
              "python"
            ],
            "enumDescriptions": [
              "package.json scripts",
              "Makefile targets",
              "composer.json scripts",
              "justfile recipes",
              ".sh files in scan directories",
              "Python entry files (app.py, main.py, ...) and venv buttons"
            ]
          },
          "default": [
            "package.json",
            "shell",
            "python"
          ],
          "uniqueItems": true,
          "description": "Script file types to scan for runnable commands. shell covers .sh files; python covers Python entry files and venv activate/deactivate/install buttons.",
          "scope": "window"
        },
        "buttons.scanDirectories": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "path": {
                "type": "string",
                "description": "Workspace-relative or absolute directory path. Absolute paths may point outside the workspace."
              },
              "recursive": {
                "type": "boolean",
                "default": false,
                "description": "Scan subdirectories too."
              }
            },
            "required": [
              "path"
            ]
          },
          "default": [],
          "description": "Extra directories to scan for scripts. The project root is always scanned at its top level. Paths outside the workspace must be absolute.",
          "scope": "resource"
        },
        "buttons.colors.actionBackground": {
          "type": "string",
          "format": "color",
          "default": "",
          "description": "Background color for all action buttons (Run, Copy, header actions, and the rest). Leave empty to inherit the VS Code theme.",
          "scope": "window"
        },
        "buttons.colors.actionForeground": {
          "type": "string",
          "format": "color",
          "default": "",
          "description": "Text color for all action buttons. Leave empty to inherit the VS Code theme.",
          "scope": "window"
        },
        "buttons.colors.commandForeground": {
          "type": "string",
          "format": "color",
          "default": "",
          "description": "Color of command text in the panel. Leave empty to inherit the editor foreground.",
          "scope": "window"
        },
        "buttons.colors.rowBackground": {
          "type": "string",
          "format": "color",
          "default": "",
          "description": "Background color for command cards and table rows. Leave empty for a transparent row.",
          "scope": "window"
        },
        "buttons.colors.background": {
          "type": "string",
          "format": "color",
          "default": "",
          "description": "Deprecated. Used as a fallback for action and row background when the dedicated settings are empty.",
          "markdownDeprecationMessage": "Use `#buttons.colors.actionBackground#` and `#buttons.colors.rowBackground#` instead.",
          "scope": "window"
        },
        "buttons.colors.foreground": {
          "type": "string",
          "format": "color",
          "default": "",
          "description": "Deprecated. Used as a fallback for action and command text when the dedicated settings are empty.",
          "markdownDeprecationMessage": "Use `#buttons.colors.actionForeground#` and `#buttons.colors.commandForeground#` instead.",
          "scope": "window"
        },
        "buttons.colors.hoverBackground": {
          "type": "string",
          "format": "color",
          "default": "",
          "description": "Hover background for action buttons. Leave empty to inherit the VS Code button theme.",
          "scope": "window"
        }
      }
    }
  },
  "scripts": {
    "clean": "node -e \"require('fs').rmSync('dist', { recursive: true, force: true })\"",
    "compile": "npm run clean && tsc -p ./",
    "watch": "tsc -w -p ./",
    "lint": "tsc -p ./ --noEmit",
    "test": "npm run compile && node --test dist/test/**/*.test.js",
    "package": "mkdir -p release && vsce package -o release/",
    "publish:marketplace": "vsce publish",
    "publish:ovsx": "ovsx publish release/buttons-vscode-*.vsix",
    "vscode:prepublish": "npm run compile"
  },
  "dependencies": {
    "@vscode/codicons": "^0.0.36"
  },
  "devDependencies": {
    "@types/node": "^22.13.10",
    "@types/vscode": "^1.97.0",
    "@vscode/vsce": "^3.9.2",
    "ovsx": "^1.1.1",
    "typescript": "^5.8.2"
  }
}
