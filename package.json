{
  "name": "buttons-vscode",
  "displayName": "Buttons",
  "description": "Turn .buttons TOML files into a clickable command panel — run, copy, and share project workflows in VS Code.",
  "version": "0.1.0",
  "publisher": "buttons-dev",
  "license": "MIT",
  "pricing": "Free",
  "icon": "media/buttons-icon-128.png",
  "galleryBanner": {
    "color": "#18181b",
    "theme": "dark"
  },
  "markdown": "github",
  "qna": "marketplace",
  "repository": {
    "type": "git",
    "url": "https://github.com/CurbSoftware/vscode-buttons.git"
  },
  "bugs": {
    "url": "https://github.com/CurbSoftware/vscode-buttons/issues"
  },
  "homepage": "https://github.com/CurbSoftware/vscode-buttons#readme",
  "keywords": [
    "buttons",
    "toml",
    "commands",
    "task-runner",
    "shortcuts",
    "workflow",
    "automation"
  ],
  "engines": {
    "node": ">=24",
    "vscode": "^1.97.0"
  },
  "categories": [
    "Other"
  ],
  "activationEvents": [
    "workspaceContains:.buttons",
    "onStartupFinished"
  ],
  "main": "./dist/extension.js",
  "contributes": {
    "viewsContainers": {
      "activitybar": [
        {
          "id": "buttons",
          "title": "Buttons",
          "icon": "media/buttons-icon.svg"
        }
      ]
    },
    "views": {
      "buttons": [
        {
          "type": "webview",
          "id": "buttons.sidebarView",
          "name": "Project Buttons"
        }
      ]
    },
    "commands": [
      {
        "command": "buttons.openPanel",
        "title": "Buttons: Open Panel",
        "icon": {
          "dark": "media/buttons-icon.svg",
          "light": "media/buttons-icon.svg"
        }
      },
      {
        "command": "buttons.reloadConfig",
        "title": "Buttons: Reload Config"
      },
      {
        "command": "buttons.openButtonsFile",
        "title": "Buttons: Open .buttons File"
      },
      {
        "command": "buttons.createExampleButtons",
        "title": "Buttons: Create Example .buttons"
      },
      {
        "command": "buttons.runButton",
        "title": "Buttons: Run Button"
      },
      {
        "command": "buttons.runButtonInNewTerminal",
        "title": "Buttons: Run Button In New Terminal"
      },
      {
        "command": "buttons.copyButtonCommand",
        "title": "Buttons: Copy Button Command"
      },
      {
        "command": "buttons.openButtonUrl",
        "title": "Buttons: Open Button URL"
      },
      {
        "command": "buttons.openButtonPort",
        "title": "Buttons: Open Button Port"
      },
      {
        "command": "buttons.openUserButtonsFile",
        "title": "Buttons: Open User .buttons File"
      },
      {
        "command": "buttons.copyToTerminal",
        "title": "Buttons: Copy to Terminal"
      },
      {
        "command": "buttons.copyToNewTerminal",
        "title": "Buttons: Copy to New Terminal"
      },
      {
        "command": "buttons.importScripts",
        "title": "Buttons: Import Scripts"
      }
    ],
    "configuration": {
      "title": "Buttons",
      "properties": {
        "buttons.defaultLayout": {
          "type": "string",
          "enum": [
            "grid",
            "rows",
            "columns",
            "table",
            "flow"
          ],
          "default": "grid",
          "description": "Fallback layout used when the .buttons file does not specify one."
        },
        "buttons.defaultTerminalMode": {
          "type": "string",
          "enum": [
            "current",
            "new"
          ],
          "default": "current",
          "description": "Fallback terminal mode used when the .buttons file does not specify one."
        },
        "buttons.showCommandPreview": {
          "type": "boolean",
          "default": true,
          "description": "Show command preview text in the Buttons panel."
        },
        "buttons.watchConfigChanges": {
          "type": "boolean",
          "default": true,
          "description": "Watch the .buttons file and refresh the panel when it changes."
        },
        "buttons.confirmDangerousCommands": {
          "type": "boolean",
          "default": true,
          "description": "Prompt before running commands marked as dangerous or matched by danger heuristics."
        },
        "buttons.autoOpen": {
          "type": "string",
          "enum": [
            "never",
            "firstTime",
            "always"
          ],
          "default": "never",
          "description": "Controls whether the Buttons sidebar opens automatically when a .buttons file exists."
        },
        "buttons.showToolbarIcon": {
          "type": "boolean",
          "default": true,
          "description": "Show the Buttons icon in the editor toolbar (top right)."
        },
        "buttons.appearance.showLabels": {
          "type": "boolean",
          "default": true,
          "description": "Show button labels in the Buttons panel."
        },
        "buttons.appearance.showIcons": {
          "type": "boolean",
          "default": true,
          "description": "Show button icons in the Buttons panel."
        },
        "buttons.appearance.compact": {
          "type": "boolean",
          "default": false,
          "description": "Use compact (dense) button layout."
        },
        "buttons.appearance.buttonColor": {
          "type": "string",
          "default": "",
          "description": "Hex color for button card borders (e.g. #FF0000). Leave empty for theme default."
        },
        "buttons.appearance.groupBackgroundColor": {
          "type": "string",
          "default": "",
          "description": "Hex color for group container backgrounds (e.g. #1a1a2e). Leave empty for theme default."
        },
        "buttons.appearance.labelSize": {
          "type": "string",
          "default": "",
          "description": "CSS font size for button labels (e.g. 16px). Leave empty for default."
        },
        "buttons.appearance.commandClickToCopy": {
          "type": "boolean",
          "default": false,
          "description": "Make command preview text clickable to copy to clipboard."
        },
        "buttons.actions.showRun": {
          "type": "boolean",
          "default": true,
          "description": "Show the Run action button."
        },
        "buttons.actions.showNewTerminal": {
          "type": "boolean",
          "default": true,
          "description": "Show the New Terminal action button."
        },
        "buttons.actions.showCopyToTerminal": {
          "type": "boolean",
          "default": true,
          "description": "Show the Copy to Terminal action button."
        },
        "buttons.actions.showCopyToNewTerminal": {
          "type": "boolean",
          "default": true,
          "description": "Show the Copy to New Terminal action button."
        },
        "buttons.actions.showCopyToClipboard": {
          "type": "boolean",
          "default": true,
          "description": "Show the Copy to Clipboard action button."
        },
        "buttons.actions.runLabel": {
          "type": "string",
          "default": "Run",
          "description": "Custom label for the Run action button."
        },
        "buttons.actions.newTerminalLabel": {
          "type": "string",
          "default": "New Terminal",
          "description": "Custom label for the New Terminal action button."
        },
        "buttons.actions.copyToTerminalLabel": {
          "type": "string",
          "default": "Copy to Terminal",
          "description": "Custom label for the Copy to Terminal action button."
        },
        "buttons.actions.copyToNewTerminalLabel": {
          "type": "string",
          "default": "Copy to New Terminal",
          "description": "Custom label for the Copy to New Terminal action button."
        },
        "buttons.actions.copyToClipboardLabel": {
          "type": "string",
          "default": "Copy",
          "description": "Custom label for the Copy to Clipboard action button."
        },
        "buttons.actions.actionSize": {
          "type": "string",
          "default": "",
          "description": "CSS font size for action buttons (e.g. 14px). Leave empty for default."
        },
        "buttons.actions.actionBorderRadius": {
          "type": "string",
          "default": "",
          "description": "CSS border radius for action buttons (e.g. 999px). Leave empty for default."
        }
      }
    },
    "menus": {
      "editor/title": [
        {
          "command": "buttons.openPanel",
          "group": "navigation",
          "when": "config.buttons.showToolbarIcon"
        }
      ]
    }
  },
  "scripts": {
    "compile": "tsc -p ./",
    "watch": "tsc -w -p ./",
    "lint": "tsc -p ./ --noEmit",
    "test": "npm run compile && node --test dist/test/**/*.test.js",
    "package": "vsce package",
    "publish:marketplace": "vsce publish",
    "publish:ovsx": "ovsx publish buttons-vscode-*.vsix",
    "vscode:prepublish": "npm run compile"
  },
  "dependencies": {
    "@iarna/toml": "^2.2.5",
    "@vscode/codicons": "^0.0.36"
  },
  "devDependencies": {
    "@types/node": "^22.13.10",
    "@types/vscode": "^1.97.0",
    "typescript": "^5.8.2"
  }
}